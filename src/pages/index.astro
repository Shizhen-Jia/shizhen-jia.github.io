---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import NewsContent from "../components/NewsContent.astro";
import PublicationList from "../components/PublicationList.astro";
import CVContent from "../components/CVContent.astro";
const lifePhotos = ["/img/life/ski1.webp", "/img/life/ski2.webp", "/img/life/ski3.webp"];
---
<BaseLayout title="Shizhen Jia | Wireless Systems & Satellite Networks" active="home">
  <div class="container">
    <section id="home" aria-labelledby="home-title">
      <div class="home-hero">
        <div class="hero-copy">
          <p class="eyebrow">Wireless communications · NYU WIRELESS</p>
          <h1 id="home-title">Shizhen Jia<span class="name-period">.</span></h1>
          <p class="hero-statement">Wireless systems, <br />from earth to orbit.</p>
          <p class="hero-description">I am a Ph.D. candidate in Electrical Engineering at <strong>New York University</strong>, advised by <a href="https://sdrangan.github.io/" target="_blank" rel="noopener">Prof. Sundeep Rangan</a>. My research explores how satellite and terrestrial networks can share spectrum and communicate reliably.</p>
          <p class="hero-description">I work on LEO satellite systems, interference nulling, anti-jamming, and wireless signal processing—from modeling and optimization to simulation and measurement.</p>
          <div class="actions hero-actions"><a class="button primary" href="#projects">Explore research ↓</a><a class="button" href="mailto:sj4025@nyu.edu">Get in touch ↗</a></div>
          <div class="social-links"><a href="https://scholar.google.com/citations?user=CzlkP7PJ-SsC&hl=en" target="_blank" rel="noopener">Google Scholar ↗</a><a href="https://github.com/Shizhen-Jia" target="_blank" rel="noopener">GitHub ↗</a><a href="https://www.linkedin.com/in/shizhen-jia-532491287/" target="_blank" rel="noopener">LinkedIn ↗</a></div>
        </div>
        <aside class="portrait-panel" aria-label="Shizhen Jia profile">
          <div class="portrait-frame"><img src="/img/head.jpg" alt="Shizhen Jia" width="420" height="500" fetchpriority="high" /></div>
          <div class="portrait-caption"><span class="status-dot" aria-hidden="true"></span><span>Ph.D. Candidate<br /><small>New York, United States</small></span></div>
          <a class="nyu-wordmark" href="https://wireless.engineering.nyu.edu/" target="_blank" rel="noopener"><img src="/img/logos/nyu-wireless.png" alt="NYU WIRELESS" width="421" height="107" /></a>
        </aside>
      </div>
      <div class="background-grid">
        <section aria-labelledby="experience-title">
          <p class="eyebrow">Research &amp; industry</p><h2 class="background-title" id="experience-title">Experience</h2>
          <article class="experience-entry">
            <div class="entry-top"><div class="organization-icon nyu-icon"><img src="/img/logos/nyu-wireless-mark.jpg" alt="" width="48" height="48" /></div><div><h3>Research Assistant</h3><p class="organization">NYU WIRELESS</p></div><p class="entry-date">Sep. 2025 — Present</p></div>
            <p class="entry-description">Research Assistant with Prof. Sundeep Rangan at NYU WIRELESS.<br />New York, United States · Full-time · On-site</p>
          </article>
          <article class="experience-entry cablelabs-entry">
            <div class="entry-top"><div class="organization-icon cablelabs-icon"><img src="/img/logos/cablelabs.svg" alt="CableLabs" width="300" height="62" /></div><div><h3>NTN Study Intern</h3><p class="organization">CableLabs</p></div><p class="entry-date">May — Aug. 2026</p></div>
            <p class="entry-location">Louisville, Colorado, United States · Internship · On-site</p>
            <ul class="experience-highlights">
              <li><strong>Reproduced 3GPP TR 38.863 NTN–TN coexistence results</strong> and extended the simulations to multi-satellite systems; developed tools for LEO spatial reuse and multi-satellite NTN–NTN interference evaluation.</li>
              <li>Developed beam-leakage-aware satellite scheduling and evaluated capacity, interference, mean and fifth-percentile throughput loss, and ACIR trade-offs.</li>
              <li>Built Starlink measurement tools combining gRPC telemetry, latency and throughput tests, route diagnostics, and Grafana dashboards with TLE-based serving-satellite estimates.</li>
              <li>Tested RadioHound spectrum-sensing hardware and investigated Wi-Fi antenna-orientation methods and NTN operation in unlicensed spectrum.</li>
            </ul>
            <div class="experience-links"><a href="/projects/leo-spatial-reuse/">LEO spatial reuse ↗</a><a href="/projects/ntn-adjacent-channel-coexistence/">NTNCoex ↗</a></div>
          </article>
        </section>
        <aside class="education-panel" aria-labelledby="education-title">
          <p class="eyebrow">Academic background</p><h2 class="background-title" id="education-title">Education</h2>
          <article class="education-entry"><img src="/img/logos/nyu.svg" alt="" width="38" height="50" /><div><h3>New York University</h3><p>Ph.D. candidate in Electrical Engineering</p><p class="education-date">Sep. 2024 — Present</p><p class="education-note">Advisor: Sundeep Rangan</p></div></article>
          <article class="education-entry"><img src="/img/logos/nyu.svg" alt="" width="38" height="50" /><div><h3>New York University</h3><p>M.S. in Electrical Engineering</p><p class="education-date">Sep. 2022 — Aug. 2024</p></div></article>
          <article class="education-entry"><img src="/img/logos/cqu.svg" alt="" width="40" height="40" /><div><h3>Chongqing University</h3><p>B.Eng. in Communication Engineering</p><p class="education-date">Sep. 2018 — Jun. 2022</p></div></article>
          <div class="education-bottom">
            <p class="eyebrow">Research Interests</p>
            <div class="tags">
              <span class="tag">Wireless Communications</span>
              <span class="tag">LEO / NTN Systems</span>
              <span class="tag">Interference Nulling</span>
              <span class="tag">Anti-Jamming</span>
              <span class="tag">TN-NTN Coexistence</span>
            </div>
          </div>
        </aside>
      </div>
    </section>
    <section id="news" class="page-section" aria-labelledby="news-title">
      <div class="section-heading"><div><p class="eyebrow">01 / Updates &amp; community</p><h2 id="news-title">News</h2></div><p class="section-intro">Research updates and contributions to the wireless communications community.</p></div>
      <NewsContent />
    </section>
    <section class="life-section" aria-labelledby="life-title">
      <div class="life-photo-wrap"><div data-life-carousel>{lifePhotos.map((photo,i) => <img src={photo} alt={"Shizhen Jia skiing and enjoying the outdoors, photo " + (i+1)} loading="lazy" decoding="async" data-life-slide hidden={i!==0} />)}</div><div class="life-controls"><button type="button" data-life-prev aria-label="Previous outdoor photo">←</button><span data-life-count aria-live="polite">1 / 3</span><button type="button" data-life-next aria-label="Next outdoor photo">→</button></div></div>
      <div class="life-copy"><p class="eyebrow">Some Cool Stuff</p><h2 id="life-title">A little time outdoors.</h2><div class="tags"><span class="tag">Skiing</span><span class="tag">Outdoors</span><span class="tag">Adventure</span></div></div>
    </section>
    <section id="projects" class="page-section" aria-labelledby="projects-title">
      <div class="section-heading"><div><p class="eyebrow">02 / Research in focus</p><h2 id="projects-title">Projects</h2></div><p class="section-intro">Explore the questions, methods, and results behind my work. Each project opens into its own research story.</p></div>
      <ProjectGrid />
    </section>
    <section id="publications" class="page-section" aria-labelledby="publications-title">
      <div class="section-heading"><div><p class="eyebrow">03 / Papers &amp; preprints</p><h2 id="publications-title">Publications</h2></div><a class="text-link" href="https://scholar.google.com/citations?user=CzlkP7PJ-SsC&hl=en" target="_blank" rel="noopener">Google Scholar ↗</a></div>
      <PublicationList />
    </section>
    <section id="cv" class="page-section" aria-labelledby="cv-title">
      <div class="section-heading"><div><p class="eyebrow">04 / The full picture</p><h2 id="cv-title">Curriculum Vitae</h2></div></div>
      <CVContent />
    </section>
  </div>
  <script>
    const slides = Array.from(document.querySelectorAll<HTMLImageElement>("[data-life-slide]"));
    const count = document.querySelector("[data-life-count]");
    let current = 0;
    const move = (direction: number) => {
      current = (current + direction + slides.length) % slides.length;
      slides.forEach((slide,i) => { slide.hidden = i !== current; });
      if (count) count.textContent = (current + 1) + " / " + slides.length;
    };
    document.querySelector("[data-life-prev]")?.addEventListener("click", () => move(-1));
    document.querySelector("[data-life-next]")?.addEventListener("click", () => move(1));
  </script>
  <style>
    .home-hero { display: grid; grid-template-columns: 1.5fr .8fr; align-items: center; gap: 90px; padding: 72px 0 60px; }
    .hero-copy h1 { font-size: clamp(54px,6vw,86px); letter-spacing: -.055em; line-height: 1.05; margin-bottom: 25px; }
    .name-period { color: var(--accent); }
    .hero-statement { font-family: var(--serif); font-size: clamp(27px,3vw,39px); line-height: 1.25; letter-spacing: -.025em; color: var(--hero-text); margin-bottom: 27px; }
    .hero-description { max-width: 680px; font-size: 15px; line-height: 1.9; }
    .hero-description + .hero-description { margin-top: 14px; }
    .hero-actions { margin-top: 30px; }
    .social-links { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 24px; font-size: 12px; }
    .social-links a { color: var(--soft); } .social-links a:hover { color: var(--accent); }
    .portrait-panel { width: min(100%,350px); justify-self: center; position: relative; padding: 14px; border: 1px solid var(--border-strong); border-radius: 24px; background: linear-gradient(145deg,var(--surface-raised),var(--surface-soft)); }
    .portrait-panel::before { content: ""; position: absolute; inset: -15px 14px 24px -15px; border: 1px solid var(--border); border-radius: 28px; z-index: -1; }
    .portrait-frame { overflow: hidden; border-radius: 15px; background: #dedbea; }
    .portrait-frame img { width: 100%; height: 330px; object-fit: cover; object-position: center 35%; }
    .portrait-caption { display: flex; align-items: center; gap: 12px; padding: 20px 8px 15px; font-size: 14px; font-weight: 600; line-height: 1.5; }
    .portrait-caption small { color: var(--soft); font-size: 12px; font-weight: 400; }
    .status-dot { width: 8px; height: 8px; flex: 0 0 8px; background: var(--accent); border-radius: 50%; box-shadow: 0 0 0 4px var(--hover); }
    .nyu-wordmark { display: inline-block; margin: 0 8px 7px 28px; width: 184px; padding: 7px; border-radius: 7px; background: #181b2c; }
    .background-grid { display: grid; grid-template-columns: 1.45fr 1fr; gap: 64px; padding-block: 60px 70px; }
    .background-title { font-size: 33px; margin-bottom: 26px; }
    .experience-entry + .experience-entry { margin-top: 26px; padding-top: 26px; border-top: 1px solid var(--border); }
    .entry-top { display: grid; grid-template-columns: 48px 1fr auto; gap: 15px; align-items: center; }
    .entry-top h3 { font-family: inherit; font-size: 17px; font-weight: 650; }
    .organization { color: var(--accent); font-size: 12px; margin-top: 4px; }
    .organization-icon { width: 48px; height: 48px; border-radius: 10px; overflow: hidden; display: grid; place-items: center; }
    .cablelabs-icon { background: white; padding: 4px; }
    .entry-date { font-size: 11px; color: var(--soft); white-space: nowrap; }
    .entry-description, .entry-location { font-size: 12px; margin: 15px 0 0 63px; }
    .experience-highlights { margin: 18px 0 18px 47px; padding-left: 16px; color: var(--muted); font-size: 13px; line-height: 1.8; }
    .experience-highlights li + li { margin-top: 10px; }
    .experience-links { display: flex; flex-wrap: wrap; gap: 20px; font-size: 12px; margin-left: 63px; }
    .education-panel { border-left: 1px solid var(--border); padding-left: 40px; }
    .education-entry { display: grid; grid-template-columns: 40px 1fr; gap: 18px; padding-bottom: 24px; }
    .education-entry + .education-entry { border-top: 1px solid var(--border); padding-top: 24px; }
    .education-entry img { width: 40px; height: 44px; padding: 4px; border-radius: 7px; background: #fff; object-fit: contain; }
    .education-entry h3 { font-family: inherit; font-size: 16px; line-height: 1.5; }
    .education-entry p { font-size: 12px; margin-top: 5px; }
    .education-entry .education-date, .education-entry .education-note { font-size: 11px; color: var(--soft); }
    .education-bottom { padding-top: 22px; border-top: 1px solid var(--border); }
    .life-section { display: grid; grid-template-columns: 1fr 1fr; gap: 55px; align-items: center; padding: 20px 0 60px; }
    .life-photo-wrap { position: relative; border-radius: 18px; overflow: hidden; }
    [data-life-carousel] { aspect-ratio: 16/9; background: var(--surface); }
    [data-life-slide] { width: 100%; height: 100%; aspect-ratio: 16/9; object-fit: cover; }
    [data-life-slide][hidden] { display: none; }
    .life-controls { position: absolute; bottom: 15px; right: 15px; display: flex; align-items: center; background: var(--header-bg); border: 1px solid var(--border-strong); border-radius: 8px; gap: 14px; padding: 4px; }
    .life-controls button { background: transparent; color: var(--text); border: 0; width: 34px; height: 34px; border-radius: 5px; }
    .life-controls button:hover { background: var(--hover); }
    .life-controls span { font-size: 11px; }
    .life-copy h2 { font-size: 36px; margin-bottom: 16px; }
    .life-copy .tags { margin-top: 22px; }
    @media(max-width:1100px) { .home-hero { gap: 45px; } .background-grid { gap: 32px; } .education-panel { padding-left: 26px; } .entry-date { white-space: normal; max-width: 100px; text-align: right; } }
    @media(max-width:760px) {
      .home-hero { grid-template-columns: 1fr; gap: 40px; padding: 45px 0; }
      .portrait-panel { width: 290px; }
      .portrait-frame img { height: 275px; }
      .hero-copy h1 { font-size: 62px; }
      .background-grid { grid-template-columns: 1fr; padding-block: 40px; gap: 45px; }
      .education-panel { border: 0; padding: 0; }
      .life-section { grid-template-columns: 1fr; gap: 24px; }
      .entry-top { grid-template-columns: 42px 1fr; }
      .entry-date { grid-column: 2; max-width: none; text-align: left; margin-top: -8px; }
      .entry-description, .entry-location, .experience-links { margin-left: 0; }
      .experience-highlights { margin-left: 0; padding-left: 18px; }
      .hero-statement br { display: none; }
    }
  </style>
</BaseLayout>
