---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Shizhen Jia | PhD Student @ NYU WIRELESS"
  active="home"
>
  <h1>Shizhen Jia</h1>
  <h2>PhD Student @ NYU WIRELESS</h2>

  <div style="display:flex; align-items:center; gap:14px; margin:12px 0 18px; flex-wrap:wrap;">
    <img
      src="/img/head1.jpg"
      alt="Shizhen Jia portrait"
      style="width:150px;height:150px;object-fit:cover;object-position:50% 18%;border-radius:50%;border:1px solid rgba(255,255,255,.2);"
    />

    <div style="display:flex; gap:10px;">
      <a
        href="https://github.com/Shizhen-Jia"
        target="_blank"
        rel="noopener"
        aria-label="GitHub"
        title="GitHub"
        style="display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:999px;border:1px solid var(--border);background:rgba(255,255,255,.03);color:var(--link);"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" style="fill:currentColor;">
          <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.1c-3.34.73-4.04-1.61-4.04-1.61a3.17 3.17 0 0 0-1.34-1.74c-1.1-.74.08-.73.08-.73a2.5 2.5 0 0 1 1.82 1.23 2.53 2.53 0 0 0 3.45.98 2.54 2.54 0 0 1 .75-1.6c-2.67-.31-5.47-1.34-5.47-5.95a4.66 4.66 0 0 1 1.24-3.23 4.33 4.33 0 0 1 .12-3.18s1.01-.32 3.3 1.24a11.38 11.38 0 0 1 6.01 0c2.29-1.56 3.3-1.24 3.3-1.24.44 1.02.48 2.17.12 3.18a4.66 4.66 0 0 1 1.24 3.23c0 4.62-2.8 5.63-5.48 5.94a2.84 2.84 0 0 1 .81 2.2v3.27c0 .32.22.69.83.58A12 12 0 0 0 12 .5Z"/>
        </svg>
      </a>

      <a
        href="https://scholar.google.com/citations?user=CzlkP7PJ-SsC&hl=en"
        target="_blank"
        rel="noopener"
        aria-label="Google Scholar"
        title="Google Scholar"
        style="display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:999px;border:1px solid rgba(255,255,255,.15);background:radial-gradient(circle at 30% 30%, rgba(255,255,255,.08), rgba(255,255,255,.02));color:#9eb5d8;box-shadow:0 6px 18px rgba(0,0,0,.35);font-family:Georgia, 'Times New Roman', serif;font-size:24px;line-height:1;text-decoration:none;"
      >
        g
      </a>

      <a
        href="https://www.linkedin.com/in/shizhen-jia-532491287/"
        target="_blank"
        rel="noopener"
        aria-label="LinkedIn"
        title="LinkedIn"
        style="display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:999px;border:1px solid var(--border);background:rgba(255,255,255,.03);color:#8ab4f8;"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" style="fill:currentColor;">
          <path d="M4.98 3.5A2.48 2.48 0 0 0 2.5 6c0 1.37 1.1 2.5 2.48 2.5h.03A2.5 2.5 0 1 0 4.98 3.5ZM3 9h4v12H3V9Zm7 0h3.84v1.72h.06c.53-1 1.84-2.06 3.78-2.06 4.04 0 4.79 2.66 4.79 6.11V21h-4v-5.5c0-1.31-.02-2.99-1.82-2.99-1.82 0-2.1 1.42-2.1 2.9V21h-4V9Z"/>
        </svg>
      </a>
    </div>
  </div>

  <p>
    I am a PhD student at <strong>NYU WIRELESS</strong>, working on non-terrestrial networks (NTN),
    LEO satellite systems, and anti-jamming techniques for future wireless communications.
  </p>

  <div class="row">
    <span class="pill">Wireless Communications</span>
    <span class="pill">LEO / NTN Systems</span>
    <span class="pill">Anti-Jamming & Null-Forming</span>
    <span class="pill">System-Level Simulation</span>
  </div>

  <div class="row" style="margin-top:22px;">
    <a class="pill" href="/projects">View Projects -></a>
    <a class="pill" href="/publications">View Publications -></a>
    <a class="pill" href="/cv">Open CV -></a>
  </div>

  <h2 style="margin-top:28px; margin-bottom:10px;">Education</h2>
  <div style="display:grid; gap:10px;">
    <div>
      <div style="display:flex; justify-content:space-between; gap:12px; flex-wrap:wrap;">
        <strong>New York University</strong>
        <span style="color:var(--muted);">Sep. 2024 - Present</span>
      </div>
      <div style="color:var(--muted);">Ph.D. candidate in Electrical Engineering, Advisor: Sundeep Rangan</div>
      <div style="color:var(--muted); text-align:right;">New York, USA</div>
    </div>

    <div>
      <div style="display:flex; justify-content:space-between; gap:12px; flex-wrap:wrap;">
        <strong>New York University</strong>
        <span style="color:var(--muted);">Sep. 2022 - Aug. 2024</span>
      </div>
      <div style="color:var(--muted);">M.S. in Electrical Engineering</div>
      <div style="color:var(--muted); text-align:right;">New York, USA</div>
    </div>

    <div>
      <div style="display:flex; justify-content:space-between; gap:12px; flex-wrap:wrap;">
        <strong>Chongqing University</strong>
        <span style="color:var(--muted);">Sep. 2018 - Jun. 2022</span>
      </div>
      <div style="color:var(--muted);">B.Eng. in Electrical Engineering</div>
      <div style="color:var(--muted); text-align:right;">China</div>
    </div>
  </div>
</BaseLayout>
