---
import BaseLayout from "../layouts/BaseLayout.astro";
import PublicationList from "../components/PublicationList.astro";
---
<BaseLayout title="Publications | Shizhen Jia" active="publications">
  <div class="container">
    <a class="breadcrumb" href="/#publications">← Back to home</a>
    <div class="page-hero publication-hero"><p class="eyebrow">Shizhen Jia · NYU WIRELESS</p><h1>Publications</h1><p>Papers and preprints on satellite networks and wireless communications.</p></div>
    <div class="library-toolbar"><p>All publications</p><a class="text-link" href="https://scholar.google.com/citations?user=CzlkP7PJ-SsC&hl=en" target="_blank" rel="noopener">Google Scholar ↗</a></div>
    <section aria-label="All publications" class="all-publications"><PublicationList /></section>
  </div>
</BaseLayout>
<style>
  .publication-hero { padding-top: 20px; }
  .library-toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px; margin-bottom: 20px; }
  .library-toolbar p { color: var(--soft); font-size: 13px; }
  .all-publications { padding-bottom: 60px; }
</style>
