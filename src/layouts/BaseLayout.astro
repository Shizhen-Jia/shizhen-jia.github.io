---
import "../styles/site.css";
const { title = "Shizhen Jia | NYU WIRELESS", description = "Shizhen Jia, Ph.D. candidate at NYU WIRELESS. Research in satellite networks, spectrum coexistence, and wireless signal processing.", active = "home" } = Astro.props;
const nav = [{key:"home",label:"Home"},{key:"news",label:"News"},{key:"projects",label:"Projects"},{key:"publications",label:"Publications"},{key:"cv",label:"CV"}];
const isHome = Astro.url.pathname === "/";
const site = Astro.site ?? new URL("https://shizhen-jia.github.io");
const canonicalUrl = new URL(Astro.url.pathname, site).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0c1218" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Shizhen Jia" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL("/img/head.jpg", site).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/img/head.jpg", site).toString()} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="navbar container">
        <a class="brand" href="/#home" aria-label="Shizhen Jia — Home">
          <span class="brand-mark" aria-hidden="true">SJ.</span>
          <span><span class="brand-name">Shizhen Jia</span><span class="brand-meta">NYU WIRELESS · ELECTRICAL ENGINEERING</span></span>
        </a>
        <nav class="navlinks" aria-label="Main navigation">
          {nav.map(item => <a href={(isHome ? "#" : "/#") + item.key} data-section-link={item.key} class:list={{active:item.key===active}} aria-current={item.key===active ? "location" : undefined}>{item.label}</a>)}
        </nav>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-content">
        <p>© {new Date().getFullYear()} Shizhen Jia · NYU WIRELESS</p>
        <div class="footer-links"><a href="mailto:sj4025@nyu.edu">Email ↗</a><a href="https://github.com/Shizhen-Jia" target="_blank" rel="noopener">GitHub ↗</a><a href="/#home">Back to top ↑</a></div>
      </div>
    </footer>
    <script>
      if (window.location.pathname === "/") {
        const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-section-link]"));
        const sections = links.map(link => document.getElementById(link.dataset.sectionLink || "")).filter((node): node is HTMLElement => node !== null);
        const update = () => {
          let current = sections[0]?.id;
          const offset = parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--header-offset")) + 20;
          for (const section of sections) if (section.getBoundingClientRect().top <= offset) current = section.id;
          for (const link of links) {
            const selected = link.dataset.sectionLink === current;
            link.classList.toggle("active", selected);
            if (selected) link.setAttribute("aria-current","location"); else link.removeAttribute("aria-current");
          }
        };
        let queued = false;
        window.addEventListener("scroll", () => {
          if (!queued) { queued = true; requestAnimationFrame(() => { update(); queued = false; }); }
        }, {passive:true});
        window.addEventListener("resize", update);
        window.addEventListener("load", update);
        update();
      }
    </script>
  </body>
</html>
