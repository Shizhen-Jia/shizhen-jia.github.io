---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    slug: "nulling-upper-mid-band",
    name: "Nulling for Terrestrial-Satellite Downlink Co-Existence in the Upper Mid-Band",
    desc: "Simulation and analysis of null-forming / interference suppression for LEO/NTN scenarios.",
    links: [{ label: "Code", href: "https://github.com/Shizhen-Jia/NTN-Nulling" }],
    tags: ["Interference Nulling", "Detection", "Channel Estimation", "NTN", "FR3", "Upper Mid-Band", "TN-NTN Co-Existence"],
    media: [],
  },
  {
    slug: "distributed-uplink-anti-jamming",
    name: "Distributed Uplink Anti-Jamming in LEO Mega-Constellations via Game-Theoretic Beamforming",
    desc: "Simulation and analysis of null-forming / interference suppression for LEO/NTN scenarios.",
    links: [{ label: "Code", href: "https://github.com/Shizhen-Jia/NTN-Anti-Jamming" }],
    tags: ["LEO satellites", "Anti-Jamming", "non-terrestrial net-works", "NTN", "game theory"],
    media: [],
  },
  {
    slug: "ota-phase-measurements-calibration",
    name: "OTA phase measurements and array calibration",
    desc: "From link-level methods to system-level evaluation with realistic geometry and overhead modeling.",
    links: [],
    tags: ["Phase Measuremen", "Multipath", "FR3 Multi-band"],
    media: [],
  },
];
---

<BaseLayout title="Projects | Shizhen Jia" active="projects">
  <h1>Projects</h1>
  <p>
    Selected projects related to NTN/LEO systems, interference suppression, and system-level simulation.
  </p>

  <div style="display:grid; gap:16px; margin-top:18px;">
    {projects.map((p) => (
      <section class="card" style="padding:18px;">
        <h2 style="margin:0 0 8px; font-size:20px; color:var(--text);">{p.name}</h2>
        <p style="margin:0 0 12px;">{p.desc}</p>

        <div style="display:flex; flex-wrap:wrap; gap:10px; margin-top:10px;">
          {p.tags.map((t) => (
            <span
              style="display:inline-flex; align-items:center; padding:7px 11px; border-radius:999px; border:1px solid var(--border); background:rgba(255,255,255,.03); color:var(--muted); font-size:13px; font-family:ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;"
            >
              {t}
            </span>
          ))}
        </div>

        {p.media?.length > 0 && (
          <div style="display:grid; gap:12px; margin-top:14px;">
            {p.media.map((m) => (
              <>
                {(m.type === "image" || m.type === "gif") && (
                  <img
                    src={m.src}
                    alt={m.alt ?? `${p.name} media`}
                    loading="lazy"
                    style="width:100%; border-radius:12px; border:1px solid var(--border);"
                  />
                )}
                {m.type === "video" && (
                  <video
                    src={m.src}
                    controls
                    preload="metadata"
                    poster={m.poster}
                    style="width:100%; border-radius:12px; border:1px solid var(--border);"
                  />
                )}
              </>
            ))}
          </div>
        )}

        {p.links?.length > 0 && (
          <div style="display:flex; flex-wrap:wrap; gap:10px; margin-top:14px;">
            {p.links.map((l) => (
              l.label.toLowerCase() === "code" ? (
                <a
                  href={l.href}
                  target="_blank"
                  rel="noopener"
                  aria-label="GitHub code repository"
                  title="GitHub code repository"
                  style="display:inline-flex; align-items:center; justify-content:center; width:40px; height:40px; border-radius:999px; border:1px solid var(--border); background:rgba(255,255,255,.03); color:var(--link);"
                >
                  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" style="fill:currentColor;">
                    <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.1c-3.34.73-4.04-1.61-4.04-1.61a3.17 3.17 0 0 0-1.34-1.74c-1.1-.74.08-.73.08-.73a2.5 2.5 0 0 1 1.82 1.23 2.53 2.53 0 0 0 3.45.98 2.54 2.54 0 0 1 .75-1.6c-2.67-.31-5.47-1.34-5.47-5.95a4.66 4.66 0 0 1 1.24-3.23 4.33 4.33 0 0 1 .12-3.18s1.01-.32 3.3 1.24a11.38 11.38 0 0 1 6.01 0c2.29-1.56 3.3-1.24 3.3-1.24.44 1.02.48 2.17.12 3.18a4.66 4.66 0 0 1 1.24 3.23c0 4.62-2.8 5.63-5.48 5.94a2.84 2.84 0 0 1 .81 2.2v3.27c0 .32.22.69.83.58A12 12 0 0 0 12 .5Z"/>
                  </svg>
                </a>
              ) : (
                <a
                  href={l.href}
                  target="_blank"
                  rel="noopener"
                  style="display:inline-flex; align-items:center; padding:8px 12px; border-radius:999px; border:1px solid var(--border); background:rgba(255,255,255,.03); color:var(--link); text-decoration:none;"
                >
                  {l.label} ->
                </a>
              )
            ))}
          </div>
        )}
      </section>
    ))}
  </div>
</BaseLayout>
