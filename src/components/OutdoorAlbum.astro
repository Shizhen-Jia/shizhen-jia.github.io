---
import type { OutdoorPhoto } from "../data/outdoors";
import "photoswipe/style.css";
interface Props {
  id: string;
  title: string;
  photos: OutdoorPhoto[];
}
const { id, title, photos } = Astro.props;
const trackId = `album-${id}-photos`;
---
<article class="outdoor-album" data-outdoor-album={id} aria-roledescription="carousel" aria-labelledby={`album-${id}-title`}>
  <div class="album-track" id={trackId} data-album-track tabindex="0" role="group" aria-label={`${title} photos`}>
    {photos.map((photo, i) => <div class:list={["album-slide", { "album-slide--graphic": photo.kind === "graphic" }]} data-album-slide role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${photos.length}`}>
      <img class="album-backdrop" src={photo.src} alt="" aria-hidden="true" loading="lazy" decoding="async" draggable="false" />
      <button class="album-photo-button" type="button" data-photo-open aria-label={`Enlarge ${title} photo ${i + 1}: ${photo.alt}`} aria-haspopup="dialog" tabindex={i === 0 ? 0 : -1} disabled>
        <img class="album-photo" src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" draggable="false" />
        <span class="album-expand" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5M3 3l6 6m12-6-6 6M3 21l6-6m12 6-6-6" /></svg></span>
      </button>
    </div>)}
  </div>
  <div class="album-footer">
    <h3 id={`album-${id}-title`}>{title}</h3>
    <div class="album-controls">
      <button type="button" data-album-prev aria-label={`Previous ${title} photo`} aria-controls={trackId} disabled>←</button>
      <span class="album-count" data-album-count aria-live="polite" aria-atomic="true">1 / {photos.length}</span>
      <button type="button" data-album-next aria-label={`Next ${title} photo`} aria-controls={trackId} disabled>→</button>
    </div>
  </div>
</article>
<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";

  document.querySelectorAll<HTMLElement>("[data-outdoor-album]").forEach(album => {
    const track = album.querySelector<HTMLElement>("[data-album-track]");
    const slides = album.querySelectorAll("[data-album-slide]");
    const count = album.querySelector<HTMLElement>("[data-album-count]");
    const previous = album.querySelector<HTMLButtonElement>("[data-album-prev]");
    const next = album.querySelector<HTMLButtonElement>("[data-album-next]");
    const imageButtons = Array.from(album.querySelectorAll<HTMLButtonElement>("[data-photo-open]"));
    if (!track || !count || !previous || !next || !slides.length) return;

    const currentIndex = () => Math.max(0, Math.min(slides.length - 1, Math.round(track.scrollLeft / track.clientWidth)));
    const updateCarousel = () => {
      const current = currentIndex();
      const label = `${current + 1} / ${slides.length}`;
      if (count.textContent !== label) count.textContent = label;
      imageButtons.forEach((button, i) => { button.tabIndex = i === current ? 0 : -1; });
    };
    const goTo = (index: number, instant = false) => {
      const target = (index + slides.length) % slides.length;
      track.scrollTo({
        left: target * track.clientWidth,
        behavior: instant || window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth",
      });
      if (instant) updateCarousel();
    };
    previous.disabled = next.disabled = slides.length < 2;
    previous.addEventListener("click", () => goTo(currentIndex() - 1));
    next.addEventListener("click", () => goTo(currentIndex() + 1));
    track.addEventListener("scroll", updateCarousel, { passive: true });
    track.addEventListener("keydown", event => {
      let target: number;
      if (event.key === "ArrowRight") target = currentIndex() + 1;
      else if (event.key === "ArrowLeft") target = currentIndex() - 1;
      else if (event.key === "Home") target = 0;
      else if (event.key === "End") target = slides.length - 1;
      else return;
      event.preventDefault();
      goTo(target);
    });

    const title = album.querySelector("h3")?.textContent ?? "Outdoor photos";
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const lightbox = new PhotoSwipeLightbox({
      dataSource: Array.from(album.querySelectorAll<HTMLImageElement>(".album-photo")).map(img => ({
        src: img.src,
        width: Number(img.getAttribute("width")),
        height: Number(img.getAttribute("height")),
        alt: img.alt,
      })),
      pswpModule: () => import("photoswipe"),
      mainClass: "outdoor-lightbox",
      bgOpacity: .96,
      showHideAnimationType: "fade",
      showAnimationDuration: reduceMotion ? 0 : 180,
      hideAnimationDuration: reduceMotion ? 0 : 180,
      zoomAnimationDuration: reduceMotion ? 0 : 200,
      paddingFn: viewport => ({ top: 64, bottom: 54, left: viewport.x < 760 ? 12 : 70, right: viewport.x < 760 ? 12 : 70 }),
      secondaryZoomLevel: zoom => Math.min(2, Math.max(1, zoom.initial * 2)),
      wheelToZoom: true,
      imageClickAction: false,
      doubleTapAction: "zoom",
      pinchToClose: false,
      closeOnVerticalDrag: false,
      returnFocus: false,
      closeTitle: "Close photo viewer (Esc)",
      zoomTitle: "Zoom in or out",
      arrowPrevTitle: "Previous photo",
      arrowNextTitle: "Next photo",
    });
    let selectedIndex = 0;
    let background: { element: HTMLElement; inert: boolean }[] = [];
    lightbox.on("uiRegister", () => {
      lightbox.pswp?.ui?.registerElement({
        name: "album-title", order: 4, isButton: false,
        onInit: element => { element.textContent = title; },
      });
      lightbox.pswp?.ui?.registerElement({
        name: "album-help", appendTo: "root", isButton: false,
        html: '<span class="mouse-help">Scroll or double-click to zoom · Drag to pan · Esc to close</span><span class="touch-help">Pinch to zoom · Swipe to browse</span>',
      });
    });
    lightbox.on("afterInit", () => {
      window.scrollTo({ left: window.scrollX, top: window.scrollY, behavior: "instant" });
      document.documentElement.classList.add("outdoor-viewer-open");
      background = Array.from(document.querySelectorAll<HTMLElement>(".site-header, #main-content, .site-footer, .skip-link")).map(element => ({ element, inert: element.inert }));
      background.forEach(({ element }) => { element.inert = true; });
      const viewer = lightbox.pswp;
      viewer?.element?.setAttribute("aria-label", `${title} photo viewer`);
      viewer?.element?.setAttribute("aria-modal", "true");
      viewer?.element?.addEventListener("dblclick", event => {
        if ((event.target as HTMLElement).classList.contains("pswp__img")) {
          event.preventDefault();
          viewer?.currSlide?.toggleZoom({ x: event.clientX, y: event.clientY });
        }
      });
    });
    lightbox.on("keydown", event => {
      if (event.originalEvent.key !== "Tab") return;
      const viewer = lightbox.pswp?.element;
      if (!viewer) return;
      viewer.classList.add("pswp--ui-visible");
      const controls = Array.from(viewer.querySelectorAll<HTMLButtonElement>("button")).filter(button => !button.disabled && button.offsetWidth > 0);
      if (!controls.length) return;
      const active = controls.indexOf(document.activeElement as HTMLButtonElement);
      const next = active < 0 ? (event.originalEvent.shiftKey ? controls.length - 1 : 0) : (active + (event.originalEvent.shiftKey ? -1 : 1) + controls.length) % controls.length;
      event.preventDefault();
      event.originalEvent.preventDefault();
      controls[next].focus();
    });
    lightbox.on("change", () => { selectedIndex = lightbox.pswp?.currIndex ?? selectedIndex; });
    lightbox.on("destroy", () => {
      document.documentElement.classList.remove("outdoor-viewer-open");
      background.forEach(({ element, inert }) => { element.inert = inert; });
      goTo(selectedIndex, true);
      imageButtons[selectedIndex]?.focus({ preventScroll: true });
    });
    lightbox.init();
    imageButtons.forEach((button, index) => {
      button.disabled = false;
      button.addEventListener("click", () => { lightbox.loadAndOpen(index); });
    });
  });
</script>
<style>
  .outdoor-album { min-width: 0; overflow: hidden; border: 1px solid var(--border); border-radius: 20px; background: linear-gradient(145deg, var(--surface-raised), var(--surface)); }
  .album-track { display: flex; width: 100%; aspect-ratio: 4 / 3; overflow: hidden; scroll-snap-type: x mandatory; scrollbar-width: none; background: var(--surface-soft); }
  .album-track::-webkit-scrollbar { display: none; }
  .album-track:focus-visible { outline: 2px solid var(--accent); outline-offset: -4px; }
  .album-slide { position: relative; isolation: isolate; flex: 0 0 100%; min-width: 0; height: 100%; overflow: hidden; scroll-snap-align: start; scroll-snap-stop: always; }
  .album-backdrop { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: blur(22px); transform: scale(1.12); opacity: .4; pointer-events: none; }
  .album-photo-button { position: relative; display: block; width: 100%; height: 100%; padding: 0; border: 0; background: transparent; cursor: zoom-in; }
  .album-photo-button:focus-visible { outline: 2px solid var(--accent); outline-offset: -4px; }
  .album-expand { position: absolute; right: 14px; bottom: 14px; display: grid; place-items: center; width: 36px; height: 36px; border: 1px solid var(--border-strong); border-radius: 9px; background: var(--header-bg); color: var(--text); pointer-events: none; }
  .album-photo-button:hover .album-expand { color: var(--accent); }
  .album-slide--graphic .album-expand { top: 14px; bottom: auto; }
  .album-photo { position: relative; width: 100%; height: 100%; object-fit: contain; user-select: none; }
  .album-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 24px; border-top: 1px solid var(--border); }
  .album-footer h3 { font-size: 29px; letter-spacing: -.02em; }
  .album-controls { display: flex; align-items: center; gap: 8px; margin-left: auto; }
  .album-controls button { display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--border); border-radius: 50%; background: var(--wash); color: var(--text); font-size: 18px; }
  .album-controls button:hover { background: var(--hover); border-color: var(--border-strong); }
  .album-controls button:disabled { opacity: .4; cursor: default; }
  .album-count { min-width: 42px; text-align: center; color: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; }
  :global(html.outdoor-viewer-open) { overflow: hidden; scrollbar-gutter: stable; }
  :global(.outdoor-lightbox) { --pswp-bg: var(--bg); --pswp-icon-color: var(--text); --pswp-icon-color-secondary: var(--surface); --pswp-icon-stroke-color: var(--bg); --pswp-placeholder-bg: var(--surface-soft); }
  :global(.outdoor-lightbox .pswp__top-bar) { align-items: center; background: linear-gradient(var(--bg), transparent); }
  :global(.outdoor-lightbox .pswp__album-title) { margin-left: 20px; font-family: var(--serif); color: var(--text); font-size: 24px; }
  :global(.outdoor-lightbox .pswp__counter) { margin: 0 auto 0 16px; height: auto; line-height: 1; white-space: nowrap; flex-shrink: 0; color: var(--muted); text-shadow: none; }
  :global(.outdoor-lightbox .pswp__album-help) { position: absolute; bottom: max(14px, env(safe-area-inset-bottom)); left: 50%; transform: translateX(-50%); width: max-content; max-width: calc(100% - 24px); padding: 7px 14px; border-radius: 8px; background: var(--header-bg); color: var(--muted); font-size: 12px; text-align: center; pointer-events: none; }
  :global(.outdoor-lightbox .touch-help) { display: none; }
  :global(.outdoor-lightbox:not(.pswp--zoomed-in) .pswp__img) { cursor: zoom-in; }
  @media (pointer: coarse) { :global(.outdoor-lightbox .mouse-help) { display: none; } :global(.outdoor-lightbox .touch-help) { display: inline; } }
  @media(max-width: 760px) {
    .album-footer { padding: 16px 18px; gap: 10px; }
    .album-footer h3 { font-size: 26px; }
    .album-controls { gap: 5px; }
    :global(.outdoor-lightbox .pswp__album-title) { margin-left: 14px; font-size: 20px; }
    :global(.outdoor-lightbox .pswp__counter) { margin-left: 10px; }
  }
</style>
