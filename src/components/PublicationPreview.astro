---
import { publications } from "../data/publications";
const latest = publications[0];
---
<div class="publication-preview">
  <div class="library-overview">
    <p class="eyebrow">Research library</p>
    <p class="library-count"><strong>{publications.length}</strong><span>papers &amp; preprints</span></p>
    <p class="library-description">Explore the full collection, including manuscripts, conference papers, and available code.</p>
    <a class="button primary" href="/publications/">View all publications <span aria-hidden="true">→</span></a>
  </div>
  {latest && <article class="latest-publication" aria-labelledby="latest-publication-title">
    <div class="latest-meta"><p class="eyebrow">Latest addition</p><span>{latest.year} · {latest.venue ?? latest.status}</span></div>
    <h3 id="latest-publication-title"><a href={latest.paperUrl} target="_blank" rel="noopener">{latest.title}</a></h3>
    <p class="authors">{latest.authors.map((author,i) => <>{i>0 ? ", " : ""}{author==="Shizhen Jia" ? <strong>{author}</strong> : author}</>)}</p>
    <a class="text-link" href={latest.paperUrl} target="_blank" rel="noopener">Read paper ↗</a>
  </article>}
</div>
<style>
  .publication-preview { display: grid; grid-template-columns: .85fr 1.4fr; gap: 44px; padding: 36px; border: 1px solid var(--border-strong); border-radius: 22px; background: linear-gradient(115deg, var(--surface-raised), var(--surface) 65%); }
  .library-overview { display: flex; flex-direction: column; align-items: flex-start; }
  .library-count { display: flex; align-items: baseline; flex-wrap: wrap; gap: 12px; }
  .library-count strong { color: var(--accent); font-family: var(--serif); font-size: 52px; line-height: 1.1; font-weight: 400; }
  .library-count span { color: var(--text); font-size: 16px; }
  .library-description { max-width: 360px; font-size: 13px; margin: 16px 0 24px; }
  .library-overview .button { margin-top: auto; }
  .latest-publication { border-left: 1px solid var(--border); padding-left: 44px; align-self: center; }
  .latest-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 18px; margin-bottom: 18px; }
  .latest-meta .eyebrow { margin: 0; }
  .latest-meta span { color: var(--soft); font-size: 12px; }
  .latest-publication h3 { font-size: clamp(23px, 2.2vw, 30px); letter-spacing: -.02em; margin-bottom: 16px; }
  .latest-publication h3 a { color: var(--text); }
  .latest-publication h3 a:hover { color: var(--accent); }
  .latest-publication .text-link { font-size: 12px; }
  @media(max-width: 1100px) { .publication-preview { gap: 28px; padding: 28px; } .latest-publication { padding-left: 28px; } }
  @media(max-width: 760px) {
    .publication-preview { grid-template-columns: 1fr; gap: 28px; padding: 26px; }
    .latest-publication { border-left: 0; border-top: 1px solid var(--border); padding: 26px 0 0; }
    .library-count strong { font-size: 44px; }
  }
</style>
