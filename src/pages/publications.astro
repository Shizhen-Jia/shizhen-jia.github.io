---
import BaseLayout from "../layouts/BaseLayout.astro";

const publications = [
  {
    title: "Joint Detection, Channel Estimation and Interference Nulling for Terrestrial-Satellite Downlink Co-Existence in the Upper Mid-Band",
    authors: "Shizhen Jia, Mingjun Ying, Marco Mezzavilla, Doru Calin, Theodore S. Rappaport, and Sundeep Rangan",
    venue: "IEEE GLOBECOM 2025 (accepted)",
    year: "2025",
    links: [
      { label: "arXiv", href: "https://arxiv.org/abs/2510.08824" },
      { label: "Code", href: "https://github.com/SJ00425/NTN-Nulling" },
    ],
    keywords: ["Interference Nulling", "Detection", "Channel Estimation", "NTN", "FR3", "Upper Mid-Band"],
  },
  {
    title: "Distributed Uplink Anti-Jamming in LEO Mega-Constellations via Game-Theoretic Beamforming",
    authors: "Shizhen Jia, Mingjun Ying, Marco Mezzavilla, Theodore S. Rappaport, and Sundeep Rangan",
    venue: "IEEE ICC 2026 (accepted)",
    year: "2026",
    links: [
      { label: "arXiv", href: "https://arxiv.org/abs/2601.15557" },
      { label: "Code", href: "https://github.com/SJ00425/NTN-Anti-Jamming" },
    ],
    keywords: ["LEO satellites", "Anti-Jamming", "NTN", "Game theory"],
  },
];
---

<BaseLayout title="Publications | Shizhen Jia" active="publications">
  <h1>Publications</h1>
  <p>Selected publications and preprints.</p>

  <div class="row" style="margin-top:12px;">
    <a
      class="pill"
      href="https://scholar.google.com/citations?user=CzlkP7PJ-SsC&hl=en"
      target="_blank"
      rel="noopener"
    >
      Google Scholar ->
    </a>
  </div>

  <div style="display:grid; gap:16px; margin-top:18px;">
    {publications.map((p) => (
      <section class="card" style="padding:18px;">
        <div style="display:flex; gap:12px; justify-content:space-between; flex-wrap:wrap;">
          <h2 style="margin:0; font-size:20px; color:var(--text);">{p.title}</h2>
          <span class="pill">{p.year}</span>
        </div>

        <p style="margin:10px 0 8px;"><strong>Authors:</strong> {p.authors}</p>
        <p style="margin:0 0 12px;"><strong>Venue:</strong> {p.venue}</p>

        <div class="row" style="margin-top:10px;">
          {p.keywords.map((k) => (
            <span class="pill">{k}</span>
          ))}
        </div>

        <div class="row" style="margin-top:14px;">
          {p.links.map((l) => (
            <a class="pill" href={l.href} target="_blank" rel="noopener">{l.label} -></a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
