---
import BaseLayout from "../layouts/BaseLayout.astro";

const publications = [
  {
    title: "Joint Detection, Channel Estimation and Interference Nulling for Terrestrial-Satellite Downlink Co-Existence in the Upper Mid-Band",
    authors: ["Shizhen Jia", "Mingjun Ying", "Marco Mezzavilla", "Doru Calin", "Theodore S. Rappaport", "Sundeep Rangan"],
    venue: "IEEE GLOBECOM 2025 (accepted)",
    year: "2025",
    paperUrl: "https://arxiv.org/abs/2510.08824",
    codeUrl: "https://github.com/SJ00425/NTN-Nulling",
    keywords: ["Interference Nulling", "Detection", "Channel Estimation", "NTN", "FR3", "Upper Mid-Band"],
  },
  {
    title: "Distributed Uplink Anti-Jamming in LEO Mega-Constellations via Game-Theoretic Beamforming",
    authors: ["Shizhen Jia", "Mingjun Ying", "Marco Mezzavilla", "Theodore S. Rappaport", "Sundeep Rangan"],
    venue: "IEEE ICC 2026 (accepted)",
    year: "2026",
    paperUrl: "https://arxiv.org/abs/2601.15557",
    codeUrl: "https://github.com/SJ00425/NTN-Anti-Jamming",
    keywords: ["LEO Satellites", "Anti-Jamming", "NTN", "Game Theory"],
  },
];

const paperLabel = (url) => (url.includes("arxiv.org") ? "Open arXiv" : "Open Paper");
---

<BaseLayout
  title="Publications | Shizhen Jia"
  description="Publications and preprints by Shizhen Jia, including IEEE GLOBECOM and IEEE ICC accepted papers."
  active="publications"
>
  <style>
    .pub-page {
      display: grid;
      gap: 18px;
    }

    .pub-hero {
      position: relative;
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 18px;
      background:
        radial-gradient(90% 145% at 100% 0%, rgba(138, 180, 248, 0.18), transparent 56%),
        linear-gradient(145deg, rgba(126, 216, 197, 0.08), rgba(255, 255, 255, 0.02) 56%),
        rgba(255, 255, 255, 0.02);
      box-shadow: inset 0 1px rgba(255, 255, 255, 0.08), 0 14px 34px rgba(0, 0, 0, 0.24);
    }

    .pub-hero::after {
      content: "";
      position: absolute;
      width: 190px;
      height: 190px;
      top: -72px;
      right: -60px;
      border-radius: 999px;
      pointer-events: none;
      background: radial-gradient(circle, rgba(126, 216, 197, 0.24), rgba(126, 216, 197, 0) 72%);
    }

    .eyebrow {
      margin: 0 0 6px;
      font-size: 12px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #9fc8ff;
      font-weight: 700;
    }

    .pub-hero h1 {
      margin: 0;
      font-size: 42px;
      letter-spacing: -0.5px;
      font-family: "Palatino Linotype", Palatino, "Book Antiqua", Georgia, serif;
      color: #f5f7ff;
    }

    .pub-hero p {
      margin: 10px 0 0;
      max-width: 760px;
      color: var(--muted);
      line-height: 1.65;
    }

    .hero-tools {
      margin-top: 14px;
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .scholar-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.18);
      background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.09), rgba(255, 255, 255, 0.02));
      color: #9eb5d8;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
      font-family: Georgia, "Times New Roman", serif;
      font-size: 28px;
      line-height: 1;
      text-decoration: none;
      transition: transform 180ms ease, border-color 180ms ease;
    }

    .scholar-btn:hover {
      transform: translateY(-2px);
      border-color: rgba(138, 180, 248, 0.45);
      text-decoration: none;
    }

    .pub-list {
      display: grid;
      gap: 16px;
    }

    .pub-card {
      position: relative;
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 18px;
      background:
        radial-gradient(100% 170% at 100% 0%, rgba(45, 128, 201, 0.15), transparent 56%),
        rgba(255, 255, 255, 0.02);
      box-shadow: inset 0 1px rgba(255, 255, 255, 0.08), 0 10px 30px rgba(0, 0, 0, 0.2);
      transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
    }

    .pub-card:hover {
      transform: translateY(-2px);
      border-color: rgba(138, 180, 248, 0.36);
      box-shadow: inset 0 1px rgba(255, 255, 255, 0.1), 0 16px 34px rgba(0, 0, 0, 0.3);
    }

    .pub-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }

    .pub-title {
      margin: 0;
      font-size: 26px;
      line-height: 1.28;
      font-family: "Palatino Linotype", Palatino, "Book Antiqua", Georgia, serif;
      letter-spacing: -0.2px;
    }

    .pub-title a {
      color: #f4f6ff;
      text-decoration: none;
      transition: color 180ms ease;
    }

    .pub-title a:hover {
      color: #d9e7ff;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .year-badge {
      display: inline-flex;
      align-items: center;
      padding: 6px 10px;
      border-radius: 999px;
      border: 1px solid rgba(126, 216, 197, 0.3);
      background: rgba(126, 216, 197, 0.1);
      color: #b7e1dc;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.02em;
      white-space: nowrap;
    }

    .authors {
      margin: 10px 0 8px;
      color: var(--muted);
      line-height: 1.62;
      font-size: 15px;
    }

    .label {
      color: #cad9f0;
      font-weight: 700;
    }

    .author-highlight {
      font-weight: 700;
      color: var(--text);
      background: rgba(138, 180, 248, 0.2);
      border-radius: 4px;
      padding: 0 4px;
    }

    .venue {
      margin: 0;
      color: #b6d3d0;
      font-weight: 600;
      line-height: 1.5;
    }

    .keywords {
      margin-top: 12px;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .keyword {
      display: inline-flex;
      align-items: center;
      padding: 7px 11px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.16);
      background: rgba(255, 255, 255, 0.03);
      color: #ccdae9;
      font-size: 12px;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    }

    .pub-actions {
      margin-top: 14px;
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .paper-btn {
      display: inline-flex;
      align-items: center;
      padding: 8px 12px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: rgba(255, 255, 255, 0.03);
      color: var(--text);
      text-decoration: none;
      font-size: 13px;
      font-weight: 650;
    }

    .paper-btn:hover {
      text-decoration: none;
      border-color: rgba(126, 216, 197, 0.36);
      background: rgba(126, 216, 197, 0.1);
    }

    .icon-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: rgba(255, 255, 255, 0.03);
      color: var(--link);
      text-decoration: none;
      transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
    }

    .icon-btn:hover {
      transform: translateY(-2px);
      border-color: rgba(138, 180, 248, 0.42);
      background: rgba(138, 180, 248, 0.12);
      text-decoration: none;
    }

    @media (max-width: 900px) {
      .pub-hero h1 {
        font-size: 36px;
      }

      .pub-title {
        font-size: 23px;
      }
    }
  </style>

  <div class="pub-page">
    <section class="pub-hero">
      <p class="eyebrow">Research Output</p>
      <h1>Publications</h1>
      <p>
        Peer-reviewed publications and preprints. Click the paper title to open the latest paper link
        (arXiv for now, IEEE link after publication).
      </p>
      <div class="hero-tools">
        <a
          class="scholar-btn"
          href="https://scholar.google.com/citations?user=CzlkP7PJ-SsC&hl=en"
          target="_blank"
          rel="noopener"
          aria-label="Google Scholar"
          title="Google Scholar"
        >
          g
        </a>
      </div>
    </section>

    <div class="pub-list">
      {publications.map((p) => (
        <article class="pub-card">
          <div class="pub-head">
            <h2 class="pub-title">
              <a href={p.paperUrl} target="_blank" rel="noopener">
                {p.title}
              </a>
            </h2>
            <span class="year-badge">{p.year}</span>
          </div>

          <p class="authors">
            <span class="label">Authors:</span>{" "}
            {p.authors.map((author, idx) => (
              <>
                {idx > 0 && (idx === p.authors.length - 1 ? ", and " : ", ")}
                {author === "Shizhen Jia" ? (
                  <span class="author-highlight">{author}</span>
                ) : (
                  author
                )}
              </>
            ))}
          </p>

          <p class="venue"><span class="label">Venue:</span> {p.venue}</p>

          <div class="keywords">
            {p.keywords.map((k) => (
              <span class="keyword">{k}</span>
            ))}
          </div>

          <div class="pub-actions">
            <a class="paper-btn" href={p.paperUrl} target="_blank" rel="noopener">
              {paperLabel(p.paperUrl)} ->
            </a>

            {p.codeUrl && (
              <a
                class="icon-btn"
                href={p.codeUrl}
                target="_blank"
                rel="noopener"
                aria-label="GitHub code repository"
                title="GitHub code repository"
              >
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" style="fill:currentColor;">
                  <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.1c-3.34.73-4.04-1.61-4.04-1.61a3.17 3.17 0 0 0-1.34-1.74c-1.1-.74.08-.73.08-.73a2.5 2.5 0 0 1 1.82 1.23 2.53 2.53 0 0 0 3.45.98 2.54 2.54 0 0 1 .75-1.6c-2.67-.31-5.47-1.34-5.47-5.95a4.66 4.66 0 0 1 1.24-3.23 4.33 4.33 0 0 1 .12-3.18s1.01-.32 3.3 1.24a11.38 11.38 0 0 1 6.01 0c2.29-1.56 3.3-1.24 3.3-1.24.44 1.02.48 2.17.12 3.18a4.66 4.66 0 0 1 1.24 3.23c0 4.62-2.8 5.63-5.48 5.94a2.84 2.84 0 0 1 .81 2.2v3.27c0 .32.22.69.83.58A12 12 0 0 0 12 .5Z"/>
                </svg>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
