---
import BaseLayout from "../layouts/BaseLayout.astro";

interface Project {
  slug: string;
  name: string;
  desc: string;
  affiliation?: string;
  approach?: string;
  links: { label: string; href: string }[];
  tags: string[];
  media: {
    type: "image" | "gif" | "video";
    src: string;
    alt?: string;
    poster?: string;
    width?: number;
    height?: number;
    caption?: string;
  }[];
  results?: { value: string; label: string; detail: string }[];
  resultNote?: string;
  poster?: { pdf: string; preview: string };
}

const projects: Project[] = [
  {
    slug: "leo-spatial-reuse",
    name: "Intra-Cell Spatial Reuse in LEO Downlinks: Beam-Leakage-Aware Satellite Scheduling",
    affiliation: "NYU WIRELESS · CableLabs",
    desc: "Enabling multiple LEO satellites to serve the same hotspot on shared spectrum. Beam-leakage-aware scheduling balances link strength and interference between overlapping beams to improve downlink capacity, with the largest gains for weaker links.",
    approach: "The BL-BnB branch-and-bound scheduler jointly considers received power and receive-array leakage, finding optimal schedules for the reference-point model. Evaluation uses a 24-hour Starlink trace with 720 snapshots, realistic antenna arrays, and atmospheric loss modeling.",
    links: [{ label: "View poster (PDF · 815 KB)", href: "/projects/leo-spatial-reuse/poster.pdf" }],
    tags: ["LEO Downlinks", "Spatial Reuse", "Satellite Scheduling", "Branch-and-Bound", "MATLAB"],
    media: [{
      type: "image",
      src: "/projects/leo-spatial-reuse/scenario.png",
      alt: "Multiple LEO satellites serve ground terminals in one cell. Solid blue arrows show desired downlinks; dashed red arrows show cochannel interference from other satellites.",
      width: 1414,
      height: 1276,
      caption: "Shared cell, shared spectrum: satellite selection must account for interference as well as signal strength.",
    }],
    results: [
      { value: "+27.2%", label: "Mean per-beam capacity", detail: "362.9 → 461.6 Mbps · 8 beams" },
      { value: "2.31×", label: "Mean per-snapshot minimum rate", detail: "173.8 → 401.3 Mbps · 8 beams" },
      { value: "267×", label: "Faster than exhaustive search", detail: "529.48 → 1.98 ms · select 8 of 28" },
    ],
    resultNote: "Simulation results reported in the poster. Capacity gains are relative to nearest-satellite selection; runtime compares BL-BnB with exhaustive search for the stated candidate pool.",
    poster: {
      pdf: "/projects/leo-spatial-reuse/poster.pdf",
      preview: "/projects/leo-spatial-reuse/poster-preview.jpg",
    },
  },
  {
    slug: "nulling-upper-mid-band",
    name: "Nulling for Terrestrial-Satellite Downlink Co-Existence in the Upper Mid-Band",
    desc: "Simulation and analysis of null-forming / interference suppression for LEO/NTN scenarios.",
    links: [{ label: "Code", href: "https://github.com/Shizhen-Jia/NTN-Nulling" }],
    tags: ["Interference Nulling", "Detection", "Channel Estimation", "NTN", "FR3", "Upper Mid-Band", "TN-NTN Co-Existence"],
    media: [],
  },
  {
    slug: "distributed-uplink-anti-jamming",
    name: "Distributed Uplink Anti-Jamming in LEO Mega-Constellations via Game-Theoretic Beamforming",
    desc: "Simulation and analysis of null-forming / interference suppression for LEO/NTN scenarios.",
    links: [{ label: "Code", href: "https://github.com/Shizhen-Jia/NTN-Anti-Jamming" }],
    tags: ["LEO Satellites", "Anti-Jamming", "Non-Terrestrial Networks", "NTN", "Game Theory"],
    media: [],
  },
  {
    slug: "ota-phase-measurements-calibration",
    name: "OTA phase measurements and array calibration",
    desc: "From link-level methods to system-level evaluation with realistic geometry and overhead modeling.",
    links: [],
    tags: ["Phase Measurement", "Multipath", "FR3 Multi-band"],
    media: [],
  },
];
---

<BaseLayout
  title="Projects | Shizhen Jia"
  description="Research projects by Shizhen Jia on LEO spatial reuse, beam-leakage-aware satellite scheduling, NTN systems, anti-jamming, and interference nulling."
  active="projects"
>
  <style>
    .projects-page {
      display: grid;
      gap: 18px;
    }

    .hero {
      position: relative;
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 18px;
      background:
        radial-gradient(90% 140% at 100% 0%, rgba(126, 216, 197, 0.18), transparent 58%),
        linear-gradient(140deg, rgba(138, 180, 248, 0.09), rgba(255, 255, 255, 0.02) 58%),
        rgba(255, 255, 255, 0.02);
      box-shadow: inset 0 1px rgba(255, 255, 255, 0.08), 0 14px 34px rgba(0, 0, 0, 0.24);
    }

    .hero::after {
      content: "";
      position: absolute;
      width: 180px;
      height: 180px;
      top: -65px;
      right: -55px;
      border-radius: 999px;
      pointer-events: none;
      background: radial-gradient(circle, rgba(138, 180, 248, 0.25), rgba(138, 180, 248, 0) 72%);
    }

    .eyebrow {
      margin: 0 0 6px;
      font-size: 12px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #9fc8ff;
      font-weight: 700;
    }

    .hero h1 {
      margin: 0;
      font-size: 42px;
      letter-spacing: -0.5px;
      font-family: "Palatino Linotype", Palatino, "Book Antiqua", Georgia, serif;
      color: #f5f7ff;
    }

    .hero p {
      margin: 10px 0 0;
      max-width: 760px;
      color: var(--muted);
      line-height: 1.65;
    }

    .hero-chips {
      margin-top: 14px;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .hero-chip {
      display: inline-flex;
      align-items: center;
      padding: 7px 11px;
      border-radius: 999px;
      border: 1px solid rgba(126, 216, 197, 0.25);
      background: rgba(126, 216, 197, 0.08);
      color: #b7e1dc;
      font-size: 12px;
      font-weight: 650;
      letter-spacing: 0.01em;
    }

    .project-list {
      display: grid;
      gap: 16px;
    }

    .project-card {
      position: relative;
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 18px;
      background:
        radial-gradient(100% 170% at 100% 0%, rgba(45, 128, 201, 0.15), transparent 56%),
        rgba(255, 255, 255, 0.02);
      box-shadow: inset 0 1px rgba(255, 255, 255, 0.08), 0 10px 30px rgba(0, 0, 0, 0.2);
      transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
      scroll-margin-top: 150px;
    }

    .project-card.featured {
      border-color: rgba(126, 216, 197, 0.3);
    }

    .project-card::before {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      border-radius: inherit;
      background: linear-gradient(
        116deg,
        rgba(255, 255, 255, 0) 18%,
        rgba(255, 255, 255, 0.12) 50%,
        rgba(255, 255, 255, 0) 82%
      );
      opacity: 0;
      transform: translateX(-65%);
      transition: transform 640ms ease, opacity 300ms ease;
    }

    .project-card:hover {
      transform: translateY(-2px);
      border-color: rgba(126, 216, 197, 0.32);
      box-shadow: inset 0 1px rgba(255, 255, 255, 0.1), 0 16px 34px rgba(0, 0, 0, 0.3);
    }

    .project-card:hover::before {
      opacity: 1;
      transform: translateX(68%);
    }

    .project-index {
      display: inline-flex;
      align-items: center;
      padding: 5px 10px;
      border-radius: 999px;
      border: 1px solid rgba(138, 180, 248, 0.35);
      background: rgba(138, 180, 248, 0.12);
      color: #c9dcff;
      font-size: 12px;
      font-weight: 650;
      margin-bottom: 10px;
    }

    .project-name {
      margin: 0;
      font-size: 27px;
      line-height: 1.24;
      color: #f4f6ff;
      letter-spacing: -0.2px;
      font-family: "Palatino Linotype", Palatino, "Book Antiqua", Georgia, serif;
    }

    .project-desc {
      margin: 10px 0 0;
      color: var(--muted);
      line-height: 1.64;
    }

    .project-affiliation {
      margin: 10px 0 0;
      color: #b7e1dc;
      font-size: 13px;
      font-weight: 600;
    }

    .project-overview.has-media {
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      align-items: start;
      gap: 22px;
      margin-top: 8px;
    }

    .project-approach {
      margin: 14px 0 0;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.7;
    }

    .project-approach strong {
      color: var(--text);
    }

    .results {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
      margin: 20px 0 0;
    }

    .result {
      display: flex;
      flex-direction: column;
      padding: 14px;
      border: 1px solid rgba(126, 216, 197, 0.2);
      border-radius: 12px;
      background: rgba(126, 216, 197, 0.05);
    }

    .result dt {
      color: var(--text);
      font-size: 13px;
      font-weight: 600;
      line-height: 1.5;
    }

    .result dd {
      margin: 0;
    }

    .result .result-value {
      order: -1;
      margin-bottom: 4px;
      color: #a2e6d7;
      font-size: 30px;
      font-weight: 750;
      letter-spacing: -0.6px;
    }

    .result .result-detail {
      margin-top: 6px;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.6;
    }

    .result-note {
      margin: 10px 0 0;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.6;
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 12px;
    }

    .tag {
      display: inline-flex;
      align-items: center;
      padding: 7px 11px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.16);
      background: rgba(255, 255, 255, 0.03);
      color: #ccdae9;
      font-size: 12px;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    }

    .media-grid {
      margin-top: 14px;
      display: grid;
      gap: 10px;
      grid-template-columns: 1fr;
    }

    .media-frame {
      margin: 0;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--border);
      background: rgba(255, 255, 255, 0.02);
    }

    .media-frame img,
    .media-frame video {
      width: 100%;
      height: auto;
      display: block;
      background: #fff;
    }

    .media-frame img {
      padding: 14px;
    }

    .media-frame figcaption {
      padding: 10px 12px;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.6;
    }

    .poster-preview {
      margin-top: 16px;
      border-top: 1px solid var(--border);
      padding-top: 4px;
    }

    .poster-preview summary {
      width: fit-content;
      max-width: 100%;
      padding: 10px 0;
      cursor: pointer;
      color: var(--link);
      font-size: 13px;
      font-weight: 600;
    }

    .poster-preview a {
      display: block;
      border-radius: 8px;
      overflow: hidden;
    }

    .poster-preview img {
      display: block;
      width: 100%;
      height: auto;
      background: #fff;
    }

    .poster-preview p {
      margin: 8px 0 0;
      font-size: 12px;
    }

    .project-card a:focus-visible,
    .poster-preview summary:focus-visible {
      outline: 2px solid #a2e6d7;
      outline-offset: 4px;
    }

    .actions {
      margin-top: 14px;
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
    }

    .icon-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: rgba(255, 255, 255, 0.03);
      color: var(--link);
      text-decoration: none;
      transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
    }

    .icon-btn:hover {
      transform: translateY(-2px);
      border-color: rgba(138, 180, 248, 0.42);
      background: rgba(138, 180, 248, 0.12);
      text-decoration: none;
    }

    .text-btn {
      display: inline-flex;
      align-items: center;
      padding: 8px 12px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: rgba(255, 255, 255, 0.03);
      color: var(--text);
      text-decoration: none;
      font-size: 13px;
      font-weight: 600;
    }

    .text-btn:hover {
      text-decoration: none;
      border-color: rgba(126, 216, 197, 0.36);
      background: rgba(126, 216, 197, 0.1);
    }

    @media (max-width: 900px) {
      .hero h1 {
        font-size: 36px;
      }

      .project-name {
        font-size: 24px;
      }

      .media-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 680px) {
      .project-overview.has-media,
      .results {
        grid-template-columns: 1fr;
      }

      .project-overview.has-media {
        gap: 0;
      }

      .media-grid {
        width: 100%;
        max-width: 360px;
        justify-self: center;
      }

      .project-card {
        padding: 16px;
      }

      .project-name {
        font-size: 23px;
        overflow-wrap: anywhere;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .project-card,
      .project-card::before,
      .icon-btn {
        transition: none;
        transform: none;
      }

      .project-card:hover,
      .icon-btn:hover {
        transform: none;
      }
    }
  </style>

  <div class="projects-page">
    <section class="hero">
      <p class="eyebrow">Research Projects</p>
      <h1>Projects</h1>
      <p>
        Selected work on NTN and LEO systems, with emphasis on spatial reuse, satellite scheduling,
        interference suppression, anti-jamming, channel estimation, and system-level evaluation.
      </p>
      <div class="hero-chips">
        <span class="hero-chip">NTN / LEO</span>
        <span class="hero-chip">Signal Processing + Systems</span>
      </div>
    </section>

    <div class="project-list">
      {projects.map((p, idx) => (
        <article id={p.slug} class:list={["project-card", { featured: !!p.poster }]} aria-labelledby={`${p.slug}-title`}>
          <span class="project-index">Project {idx + 1}</span>
          <h2 class="project-name" id={`${p.slug}-title`}>{p.name}</h2>
          {p.affiliation && <p class="project-affiliation">{p.affiliation}</p>}
          <div class:list={["project-overview", { "has-media": p.media.length > 0 }]}>
            <div>
              <p class="project-desc">{p.desc}</p>
              {p.approach && <p class="project-approach"><strong>Approach.</strong> {p.approach}</p>}

              <div class="tags">
                {p.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
            </div>

            {p.media.length > 0 && (
              <div class="media-grid">
                {p.media.map((m) => (
                  <figure class="media-frame">
                    {(m.type === "image" || m.type === "gif") && (
                      <img
                        src={m.src}
                        alt={m.alt ?? `${p.name} media`}
                        loading="lazy"
                        decoding="async"
                        width={m.width}
                        height={m.height}
                      />
                    )}
                    {m.type === "video" && (
                      <video
                        src={m.src}
                        controls
                        preload="metadata"
                        poster={m.poster}
                      />
                    )}
                    {m.caption && <figcaption>{m.caption}</figcaption>}
                  </figure>
                ))}
              </div>
            )}
          </div>

          {p.results && (
            <dl class="results" aria-label="Simulation highlights">
              {p.results.map((result) => (
                <div class="result">
                  <dt>{result.label}</dt>
                  <dd class="result-value">{result.value}</dd>
                  <dd class="result-detail">{result.detail}</dd>
                </div>
              ))}
            </dl>
          )}
          {p.resultNote && <p class="result-note">{p.resultNote}</p>}

          {p.links?.length > 0 && (
            <div class="actions">
              {p.links.map((l) => (
                l.label.toLowerCase() === "code" ? (
                  <a
                    class="icon-btn"
                    href={l.href}
                    target="_blank"
                    rel="noopener"
                    aria-label="GitHub code repository"
                    title="GitHub code repository"
                  >
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" style="fill:currentColor;">
                      <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.1c-3.34.73-4.04-1.61-4.04-1.61a3.17 3.17 0 0 0-1.34-1.74c-1.1-.74.08-.73.08-.73a2.5 2.5 0 0 1 1.82 1.23 2.53 2.53 0 0 0 3.45.98 2.54 2.54 0 0 1 .75-1.6c-2.67-.31-5.47-1.34-5.47-5.95a4.66 4.66 0 0 1 1.24-3.23 4.33 4.33 0 0 1 .12-3.18s1.01-.32 3.3 1.24a11.38 11.38 0 0 1 6.01 0c2.29-1.56 3.3-1.24 3.3-1.24.44 1.02.48 2.17.12 3.18a4.66 4.66 0 0 1 1.24 3.23c0 4.62-2.8 5.63-5.48 5.94a2.84 2.84 0 0 1 .81 2.2v3.27c0 .32.22.69.83.58A12 12 0 0 0 12 .5Z"/>
                    </svg>
                  </a>
                ) : (
                  <a
                    class="text-btn"
                    href={l.href}
                    target="_blank"
                    rel="noopener"
                  >
                    {l.label} ->
                  </a>
                )
              ))}
            </div>
          )}
          {p.poster && (
            <details class="poster-preview">
              <summary>Preview full research poster</summary>
              <a href={p.poster.pdf} target="_blank" rel="noopener" aria-label={`Open the full-resolution PDF poster for ${p.name} (opens in a new tab)`}>
                <img
                  src={p.poster.preview}
                  alt="Research poster with the system scenario, BL-BnB scheduling method, capacity comparisons, and runtime benchmarks. Key findings are summarized above."
                  width="1800"
                  height="1200"
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <p>Select the poster to read the full-resolution PDF in a new tab.</p>
            </details>
          )}
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
