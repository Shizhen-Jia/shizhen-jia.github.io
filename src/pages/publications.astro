---
import BaseLayout from "../layouts/BaseLayout.astro";

const publications = [
  {
    title: "Joint Detection, Channel Estimation and Interference Nulling for Terrestrial-Satellite Downlink Co-Existence in the Upper Mid-Band",
    authors: ["Shizhen Jia", "Mingjun Ying", "Marco Mezzavilla", "Doru Calin", "Theodore S. Rappaport", "Sundeep Rangan"],
    venue: "IEEE GLOBECOM 2025 (accepted)",
    year: "2025",
    paperUrl: "https://arxiv.org/abs/2510.08824",
    codeUrl: "https://github.com/SJ00425/NTN-Nulling",
    keywords: ["Interference Nulling", "Detection", "Channel Estimation", "NTN", "FR3", "Upper Mid-Band"],
  },
  {
    title: "Distributed Uplink Anti-Jamming in LEO Mega-Constellations via Game-Theoretic Beamforming",
    authors: ["Shizhen Jia", "Mingjun Ying", "Marco Mezzavilla", "Theodore S. Rappaport", "Sundeep Rangan"],
    venue: "IEEE ICC 2026 (accepted)",
    year: "2026",
    paperUrl: "https://arxiv.org/abs/2601.15557",
    codeUrl: "https://github.com/SJ00425/NTN-Anti-Jamming",
    keywords: ["LEO satellites", "Anti-Jamming", "NTN", "Game theory"],
  },
];
---

<BaseLayout title="Publications | Shizhen Jia" active="publications">
  <h1>Publications</h1>
  <p>Selected publications and preprints.</p>

  <div style="display:flex; gap:10px; margin-top:12px;">
    <a
      href="https://scholar.google.com/citations?user=CzlkP7PJ-SsC&hl=en"
      target="_blank"
      rel="noopener"
      aria-label="Google Scholar"
      title="Google Scholar"
      style="display:inline-flex; align-items:center; justify-content:center; width:44px; height:44px; border-radius:999px; border:1px solid rgba(255,255,255,.15); background:radial-gradient(circle at 30% 30%, rgba(255,255,255,.08), rgba(255,255,255,.02)); color:#9eb5d8; box-shadow:0 6px 18px rgba(0,0,0,.35); font-family:Georgia, 'Times New Roman', serif; font-size:28px; line-height:1; text-decoration:none;"
    >
      g
    </a>
  </div>

  <div style="display:grid; gap:16px; margin-top:18px;">
    {publications.map((p) => (
      <section class="card" style="padding:18px;">
        <div style="display:flex; gap:12px; justify-content:space-between; flex-wrap:wrap;">
          <h2 style="margin:0; font-size:20px; color:var(--text);">
            <a href={p.paperUrl} target="_blank" rel="noopener" style="color:var(--text); text-decoration:none;">
              {p.title}
            </a>
          </h2>
          <span class="pill">{p.year}</span>
        </div>

        <p style="margin:10px 0 8px;">
          <strong>Authors:</strong>{" "}
          {p.authors.map((author, idx) => (
            <>
              {idx > 0 && (idx === p.authors.length - 1 ? ", and " : ", ")}
              {author === "Shizhen Jia" ? (
                <span style="font-weight:700; color:var(--text); background:rgba(138,180,248,.18); padding:0 4px; border-radius:4px;">
                  {author}
                </span>
              ) : (
                author
              )}
            </>
          ))}
        </p>
        <p style="margin:0 0 12px;"><strong>Venue:</strong> {p.venue}</p>

        <div style="display:flex; flex-wrap:wrap; gap:10px; margin-top:10px;">
          {p.keywords.map((k) => (
            <span
              style="display:inline-flex; align-items:center; padding:7px 11px; border-radius:999px; border:1px solid var(--border); background:rgba(255,255,255,.03); color:var(--muted); font-size:13px;"
            >
              {k}
            </span>
          ))}
        </div>

        <div style="display:flex; gap:10px; margin-top:14px;">
          <a
            href={p.codeUrl}
            target="_blank"
            rel="noopener"
            aria-label="GitHub code repository"
            title="GitHub code repository"
            style="display:inline-flex; align-items:center; justify-content:center; width:40px; height:40px; border-radius:999px; border:1px solid var(--border); background:rgba(255,255,255,.03);"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" style="fill:currentColor;">
              <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.1c-3.34.73-4.04-1.61-4.04-1.61a3.17 3.17 0 0 0-1.34-1.74c-1.1-.74.08-.73.08-.73a2.5 2.5 0 0 1 1.82 1.23 2.53 2.53 0 0 0 3.45.98 2.54 2.54 0 0 1 .75-1.6c-2.67-.31-5.47-1.34-5.47-5.95a4.66 4.66 0 0 1 1.24-3.23 4.33 4.33 0 0 1 .12-3.18s1.01-.32 3.3 1.24a11.38 11.38 0 0 1 6.01 0c2.29-1.56 3.3-1.24 3.3-1.24.44 1.02.48 2.17.12 3.18a4.66 4.66 0 0 1 1.24 3.23c0 4.62-2.8 5.63-5.48 5.94a2.84 2.84 0 0 1 .81 2.2v3.27c0 .32.22.69.83.58A12 12 0 0 0 12 .5Z"/>
            </svg>
          </a>
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
