---
import { publications } from "../data/publications";
const featured = publications.find(p => p.venue === "IEEE GLOBECOM 2025");
---
<div class="publication-preview">
  <div class="library-overview">
    <p class="eyebrow">Research library</p>
    <h3 class="library-title">Papers &amp; preprints</h3>
    <p class="library-description">Explore the full collection, including manuscripts, conference papers, and available code.</p>
    <a class="button primary" href="/publications/">View all publications <span aria-hidden="true">→</span></a>
  </div>
  {featured && <article class="featured-publication" aria-labelledby="featured-publication-title">
    <div class="featured-meta"><p class="eyebrow">Selected publication</p><span>{featured.venue ?? featured.year}</span></div>
    <h3 id="featured-publication-title"><a href={featured.paperUrl} target="_blank" rel="noopener">{featured.title}</a></h3>
    <p class="authors">{featured.authors.map((author,i) => <>{i>0 ? ", " : ""}{author==="Shizhen Jia" ? <strong>{author}</strong> : author}</>)}</p>
    <a class="text-link" href={featured.paperUrl} target="_blank" rel="noopener">Read paper ↗</a>
  </article>}
</div>
<style>
  .publication-preview { display: grid; grid-template-columns: .85fr 1.4fr; gap: 44px; padding: 36px; border: 1px solid var(--border-strong); border-radius: 22px; background: linear-gradient(115deg, var(--surface-raised), var(--surface) 65%); }
  .library-overview { display: flex; flex-direction: column; align-items: flex-start; }
  .library-title { font-size: 30px; letter-spacing: -.02em; }
  .library-description { max-width: 360px; font-size: 13px; margin: 16px 0 24px; }
  .library-overview .button { margin-top: auto; }
  .featured-publication { border-left: 1px solid var(--border); padding-left: 44px; align-self: center; }
  .featured-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 18px; margin-bottom: 18px; }
  .featured-meta .eyebrow { margin: 0; }
  .featured-meta span { color: var(--soft); font-size: 12px; }
  .featured-publication h3 { font-size: clamp(23px, 2.2vw, 30px); letter-spacing: -.02em; margin-bottom: 16px; }
  .featured-publication h3 a { color: var(--text); }
  .featured-publication h3 a:hover { color: var(--accent); }
  .featured-publication .text-link { font-size: 12px; }
  @media(max-width: 1100px) { .publication-preview { gap: 28px; padding: 28px; } .featured-publication { padding-left: 28px; } }
  @media(max-width: 760px) {
    .publication-preview { grid-template-columns: 1fr; gap: 28px; padding: 26px; }
    .featured-publication { border-left: 0; border-top: 1px solid var(--border); padding: 26px 0 0; }
  }
</style>
