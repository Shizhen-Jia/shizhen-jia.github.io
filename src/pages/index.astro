---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Shizhen Jia | PhD Candidate @ NYU WIRELESS"
  active="home"
>
  <style>
    .home-wrap {
      position: relative;
      isolation: isolate;
    }

    .home-wrap::before,
    .home-wrap::after {
      content: "";
      position: absolute;
      z-index: -1;
      pointer-events: none;
      border-radius: 999px;
      filter: blur(40px);
      opacity: 0.52;
    }

    .home-wrap::before {
      width: 340px;
      height: 340px;
      right: 12%;
      top: -70px;
      background: radial-gradient(circle, rgba(126, 216, 197, 0.36) 0%, rgba(126, 216, 197, 0) 72%);
      animation: drift-a 15s ease-in-out infinite alternate;
    }

    .home-wrap::after {
      width: 420px;
      height: 420px;
      left: -110px;
      bottom: -170px;
      background: radial-gradient(circle, rgba(78, 157, 255, 0.34) 0%, rgba(78, 157, 255, 0) 72%);
      animation: drift-b 19s ease-in-out infinite alternate;
    }

    .home {
      display: grid;
      grid-template-columns: minmax(250px, 320px) 1fr;
      gap: 22px;
      align-items: start;
    }

    .reveal {
      opacity: 0;
      transform: translateY(16px);
      animation: fade-up 680ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .delay-1 { animation-delay: 80ms; }
    .delay-2 { animation-delay: 170ms; }
    .delay-3 { animation-delay: 260ms; }
    .delay-4 { animation-delay: 350ms; }
    .delay-5 { animation-delay: 440ms; }

    .profile-card {
      position: relative;
      overflow: hidden;
      padding: 18px;
      border-radius: 18px;
      border: 1px solid var(--border);
      background:
        linear-gradient(150deg, rgba(138, 180, 248, 0.12), rgba(255, 255, 255, 0.02) 55%),
        rgba(255, 255, 255, 0.02);
      box-shadow: inset 0 1px rgba(255, 255, 255, 0.08), 0 14px 36px rgba(0, 0, 0, 0.28);
      transition: border-color 220ms ease, box-shadow 220ms ease, transform 220ms ease;
    }

    .profile-card::before {
      content: "";
      position: absolute;
      width: 180px;
      height: 180px;
      right: -70px;
      top: -65px;
      border-radius: 999px;
      pointer-events: none;
      background: radial-gradient(circle, rgba(138, 180, 248, 0.24) 0%, rgba(138, 180, 248, 0) 75%);
    }

    .profile-card:hover {
      transform: translateY(-2px);
      border-color: rgba(126, 216, 197, 0.35);
      box-shadow: inset 0 1px rgba(255, 255, 255, 0.1), 0 18px 42px rgba(0, 0, 0, 0.34);
    }

    .portrait {
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      object-position: 50% 18%;
      border-radius: 14px;
      border: 1px solid rgba(255, 255, 255, 0.22);
      opacity: 0;
      transform: scale(0.98);
      animation: portrait-in 820ms cubic-bezier(0.22, 1, 0.36, 1) 140ms forwards;
    }

    .name {
      margin: 14px 0 6px;
      font-size: 40px;
      line-height: 1.05;
      font-family: "Palatino Linotype", Palatino, "Book Antiqua", Georgia, serif;
      letter-spacing: -0.4px;
      color: #f5f7ff;
    }

    .role {
      margin: 0 0 6px;
      font-size: 18px;
      color: #a8d2d2;
      line-height: 1.3;
      font-weight: 650;
    }

    .affil {
      margin: 0;
      color: var(--muted);
      line-height: 1.45;
    }

    .social-row {
      margin-top: 14px;
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .icon-btn {
      display: inline-flex;
      width: 42px;
      height: 42px;
      border-radius: 999px;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--border);
      background: rgba(255, 255, 255, 0.03);
      color: var(--link);
      text-decoration: none;
      transition: transform 180ms ease, background 180ms ease, border-color 180ms ease;
      opacity: 0;
      transform: translateY(8px) scale(0.96);
      animation: icon-in 560ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .social-row .icon-btn:nth-child(1) { animation-delay: 420ms; }
    .social-row .icon-btn:nth-child(2) { animation-delay: 500ms; }
    .social-row .icon-btn:nth-child(3) { animation-delay: 580ms; }

    .icon-btn:hover {
      transform: translateY(-2px);
      background: rgba(138, 180, 248, 0.14);
      border-color: rgba(138, 180, 248, 0.4);
      text-decoration: none;
    }

    .icon-btn.scholar {
      border-color: rgba(255, 255, 255, 0.15);
      background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02));
      color: #9eb5d8;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
      font-family: Georgia, "Times New Roman", serif;
      font-size: 25px;
      line-height: 1;
    }

    .content {
      display: grid;
      gap: 16px;
    }

    .panel {
      position: relative;
      overflow: hidden;
      padding: 18px;
      border-radius: 16px;
      border: 1px solid var(--border);
      background:
        radial-gradient(120% 160% at 100% 0%, rgba(45, 128, 201, 0.15), transparent 55%),
        rgba(255, 255, 255, 0.02);
      backdrop-filter: blur(4px);
      box-shadow: inset 0 1px rgba(255, 255, 255, 0.08), 0 12px 30px rgba(0, 0, 0, 0.2);
      transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
    }

    .panel::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      border-radius: inherit;
      background: linear-gradient(
        118deg,
        rgba(255, 255, 255, 0) 18%,
        rgba(255, 255, 255, 0.14) 48%,
        rgba(255, 255, 255, 0) 78%
      );
      opacity: 0;
      transform: translateX(-65%);
      transition: transform 620ms ease, opacity 320ms ease;
    }

    .panel:hover {
      transform: translateY(-2px);
      border-color: rgba(126, 216, 197, 0.32);
      box-shadow: inset 0 1px rgba(255, 255, 255, 0.1), 0 18px 38px rgba(0, 0, 0, 0.28);
    }

    .panel:hover::after {
      opacity: 1;
      transform: translateX(68%);
    }

    .section-title {
      margin: 0 0 10px;
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 30px;
      line-height: 1.1;
      font-family: "Palatino Linotype", Palatino, "Book Antiqua", Georgia, serif;
      color: #f2f5ff;
      letter-spacing: -0.35px;
    }

    .section-dot {
      width: 12px;
      height: 12px;
      border-radius: 999px;
      background: #7ed8c5;
      box-shadow: 0 0 0 6px rgba(126, 216, 197, 0.12);
      flex: 0 0 auto;
    }

    .summary-text {
      margin: 0;
      line-height: 1.68;
      color: var(--muted);
    }

    .quick-row {
      margin-top: 14px;
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .quick-link {
      display: inline-flex;
      align-items: center;
      padding: 8px 12px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: rgba(255, 255, 255, 0.03);
      color: var(--text);
      text-decoration: none;
      font-size: 13px;
      font-weight: 600;
    }

    .quick-link:hover {
      text-decoration: none;
      border-color: rgba(138, 180, 248, 0.48);
      background: rgba(138, 180, 248, 0.12);
      box-shadow: 0 0 0 4px rgba(138, 180, 248, 0.08);
    }

    .edu-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }

    .edu-card {
      position: relative;
      overflow: hidden;
      padding: 14px;
      border-radius: 14px;
      border: 1px solid var(--border);
      background:
        linear-gradient(150deg, rgba(138, 180, 248, 0.08), rgba(255, 255, 255, 0.02) 60%),
        rgba(255, 255, 255, 0.02);
      transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
    }

    .edu-card::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      top: 0;
      height: 1px;
      background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.38), rgba(255, 255, 255, 0));
      pointer-events: none;
    }

    .edu-card:hover {
      transform: translateY(-2px);
      border-color: rgba(138, 180, 248, 0.38);
      box-shadow: 0 12px 26px rgba(0, 0, 0, 0.2);
    }

    .edu-school {
      margin: 0;
      color: #f2f4ff;
      font-weight: 700;
      line-height: 1.3;
      font-size: 20px;
      font-family: "Palatino Linotype", Palatino, "Book Antiqua", Georgia, serif;
    }

    .edu-degree {
      margin: 8px 0 6px;
      color: #cbe6e6;
      line-height: 1.42;
      font-size: 14px;
      font-style: italic;
    }

    .edu-meta {
      margin: 0;
      color: var(--muted);
      line-height: 1.46;
      font-size: 14px;
    }

    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 8px;
    }

    .chip {
      display: inline-flex;
      align-items: center;
      border-radius: 999px;
      border: 1px solid rgba(126, 216, 197, 0.22);
      background: rgba(126, 216, 197, 0.08);
      color: #b9dfd9;
      padding: 8px 12px;
      font-size: 13px;
      line-height: 1.3;
      font-weight: 600;
      opacity: 0;
      transform: translateY(8px);
      animation: fade-up 560ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .chips .chip:nth-child(1) { animation-delay: 520ms; }
    .chips .chip:nth-child(2) { animation-delay: 590ms; }
    .chips .chip:nth-child(3) { animation-delay: 660ms; }
    .chips .chip:nth-child(4) { animation-delay: 730ms; }
    .chips .chip:nth-child(5) { animation-delay: 800ms; }

    .life-panel {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: 14px;
      align-items: stretch;
      margin-top: 2px;
    }

    .life-subtitle {
      margin: 0 0 10px;
      color: #9fc8ff;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .life-photo-wrap {
      position: relative;
      overflow: hidden;
      border-radius: 14px;
      border: 1px solid rgba(255, 255, 255, 0.2);
      min-height: 250px;
      background: rgba(255, 255, 255, 0.02);
    }

    .life-photo {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
      transform: scale(1.02);
      transition: transform 480ms ease;
    }

    .life-photo-wrap::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        linear-gradient(180deg, rgba(11, 16, 32, 0.02), rgba(11, 16, 32, 0.55));
    }

    .life-panel:hover .life-photo {
      transform: scale(1.06);
    }

    .life-copy {
      border-radius: 14px;
      border: 1px solid rgba(126, 216, 197, 0.22);
      background:
        radial-gradient(110% 160% at 100% 0%, rgba(126, 216, 197, 0.14), transparent 56%),
        rgba(255, 255, 255, 0.02);
      padding: 14px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .life-copy p {
      margin: 0;
      color: var(--muted);
      line-height: 1.65;
    }

    .life-badges {
      margin-top: 12px;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .life-badge {
      display: inline-flex;
      align-items: center;
      border-radius: 999px;
      border: 1px solid rgba(126, 216, 197, 0.22);
      background: rgba(126, 216, 197, 0.08);
      color: #b9dfd9;
      padding: 7px 11px;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.01em;
    }

    @keyframes fade-up {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes portrait-in {
      from {
        opacity: 0;
        transform: scale(0.98);
        filter: saturate(0.9);
      }
      to {
        opacity: 1;
        transform: scale(1);
        filter: saturate(1);
      }
    }

    @keyframes icon-in {
      from {
        opacity: 0;
        transform: translateY(8px) scale(0.96);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    @keyframes drift-a {
      from {
        transform: translate3d(-8px, -6px, 0);
      }
      to {
        transform: translate3d(10px, 12px, 0);
      }
    }

    @keyframes drift-b {
      from {
        transform: translate3d(8px, 8px, 0);
      }
      to {
        transform: translate3d(-10px, -12px, 0);
      }
    }

    @media (max-width: 980px) {
      .home {
        grid-template-columns: 1fr;
      }

      .profile-card {
        max-width: 460px;
        width: 100%;
      }

      .name {
        font-size: 36px;
      }

      .edu-grid {
        grid-template-columns: 1fr;
      }

      .life-panel {
        grid-template-columns: 1fr;
      }

      .life-photo-wrap {
        min-height: 220px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .home-wrap::before,
      .home-wrap::after {
        animation: none !important;
      }

      .reveal,
      .portrait,
      .icon-btn,
      .chip {
        animation: none !important;
        opacity: 1 !important;
        transform: none !important;
      }

      .icon-btn {
        transition: none;
      }

      .life-photo {
        transition: none;
      }
    }
  </style>

  <div class="home-wrap">
    <div class="home">
    <aside class="profile-card reveal delay-1">
      <img class="portrait" src="/img/head.jpg" alt="Shizhen Jia portrait" />
      <h1 class="name">Shizhen Jia</h1>
      <p class="role">Ph.D. Candidate in Electrical Engineering</p>
      <p class="affil">NYU WIRELESS, New York University</p>

      <div class="social-row">
        <a
          class="icon-btn"
          href="https://github.com/Shizhen-Jia"
          target="_blank"
          rel="noopener"
          aria-label="GitHub"
          title="GitHub"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" style="fill:currentColor;">
            <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.1c-3.34.73-4.04-1.61-4.04-1.61a3.17 3.17 0 0 0-1.34-1.74c-1.1-.74.08-.73.08-.73a2.5 2.5 0 0 1 1.82 1.23 2.53 2.53 0 0 0 3.45.98 2.54 2.54 0 0 1 .75-1.6c-2.67-.31-5.47-1.34-5.47-5.95a4.66 4.66 0 0 1 1.24-3.23 4.33 4.33 0 0 1 .12-3.18s1.01-.32 3.3 1.24a11.38 11.38 0 0 1 6.01 0c2.29-1.56 3.3-1.24 3.3-1.24.44 1.02.48 2.17.12 3.18a4.66 4.66 0 0 1 1.24 3.23c0 4.62-2.8 5.63-5.48 5.94a2.84 2.84 0 0 1 .81 2.2v3.27c0 .32.22.69.83.58A12 12 0 0 0 12 .5Z"/>
          </svg>
        </a>

        <a
          class="icon-btn scholar"
          href="https://scholar.google.com/citations?user=CzlkP7PJ-SsC&hl=en"
          target="_blank"
          rel="noopener"
          aria-label="Google Scholar"
          title="Google Scholar"
        >
          g
        </a>

        <a
          class="icon-btn"
          href="https://www.linkedin.com/in/shizhen-jia-532491287/"
          target="_blank"
          rel="noopener"
          aria-label="LinkedIn"
          title="LinkedIn"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" style="fill:currentColor;">
            <path d="M4.98 3.5A2.48 2.48 0 0 0 2.5 6c0 1.37 1.1 2.5 2.48 2.5h.03A2.5 2.5 0 1 0 4.98 3.5ZM3 9h4v12H3V9Zm7 0h3.84v1.72h.06c.53-1 1.84-2.06 3.78-2.06 4.04 0 4.79 2.66 4.79 6.11V21h-4v-5.5c0-1.31-.02-2.99-1.82-2.99-1.82 0-2.1 1.42-2.1 2.9V21h-4V9Z"/>
          </svg>
        </a>
      </div>
    </aside>

    <div class="content">
      <section class="panel reveal delay-2">
        <h2 class="section-title"><span class="section-dot"></span>Professional Summary</h2>
        <p class="summary-text">
          Ph.D. candidate at <strong style="color:var(--text);">NYU WIRELESS</strong> focusing on non-terrestrial
          networks, LEO satellite systems, anti-jamming, and interference nulling for future wireless communications.
        </p>
        <div class="quick-row">
          <a class="quick-link" href="/projects">View Projects -></a>
          <a class="quick-link" href="/publications">View Publications -></a>
          <a class="quick-link" href="/cv">Open CV -></a>
        </div>
      </section>

      <section class="panel reveal delay-3">
        <h2 class="section-title"><span class="section-dot"></span>Education</h2>
        <div class="edu-grid">
          <article class="edu-card">
            <h3 class="edu-school">New York University</h3>
            <p class="edu-degree">Ph.D. candidate in Electrical Engineering, Advisor: Sundeep Rangan</p>
            <p class="edu-meta">Sep. 2024 - Present</p>
            <p class="edu-meta">New York, USA</p>
          </article>

          <article class="edu-card">
            <h3 class="edu-school">New York University</h3>
            <p class="edu-degree">M.S. in Electrical Engineering</p>
            <p class="edu-meta">Sep. 2022 - Aug. 2024</p>
            <p class="edu-meta">New York, USA</p>
          </article>

          <article class="edu-card">
            <h3 class="edu-school">Chongqing University</h3>
            <p class="edu-degree">B.Eng. in Electrical Engineering</p>
            <p class="edu-meta">Sep. 2018 - Jun. 2022</p>
            <p class="edu-meta">China</p>
          </article>
        </div>
      </section>

      <section class="panel reveal delay-4">
        <h2 class="section-title"><span class="section-dot"></span>Research Interests</h2>
        <div class="chips">
          <span class="chip">Wireless Communications</span>
          <span class="chip">LEO / NTN Systems</span>
          <span class="chip">Interference Nulling</span>
          <span class="chip">Anti-Jamming</span>
          <span class="chip">System-Level Simulation</span>
        </div>
      </section>

      <section class="panel reveal delay-5">
        <h2 class="section-title"><span class="section-dot"></span>Beyond Research</h2>
        <p class="life-subtitle">Life Outside The Lab</p>
        <div class="life-panel">
          <figure class="life-photo-wrap">
            <img class="life-photo" src="/Interests/ski1.jpg" alt="Skiing in winter mountains" loading="lazy" />
          </figure>
          <div class="life-copy">
            <p>
              Outside the lab, I enjoy alpine skiing. It is a way to stay energized, reset focus, and
              keep a balance between deep research work and outdoor challenges.
            </p>
            <div class="life-badges">
              <span class="life-badge">Skiing</span>
              <span class="life-badge">Outdoor</span>
              <span class="life-badge">Adventure</span>
            </div>
          </div>
        </div>
      </section>
    </div>
    </div>
  </div>
</BaseLayout>
