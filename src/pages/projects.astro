---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    slug: "nulling-upper-mid-band",
    name: "Nulling for Terrestrial-Satellite Downlink Co-Existence in the Upper Mid-Band",
    desc: "Simulation and analysis of null-forming / interference suppression for LEO/NTN scenarios.",
    links: [{ label: "Code", href: "https://github.com/Shizhen-Jia/NTN-Nulling" }],
    tags: ["Interference Nulling", "Detection", "Channel Estimation", "NTN", "FR3", "Upper Mid-Band", "TN-NTN Co-Existence"],
    media: [],
  },
  {
    slug: "distributed-uplink-anti-jamming",
    name: "Distributed Uplink Anti-Jamming in LEO Mega-Constellations via Game-Theoretic Beamforming",
    desc: "Simulation and analysis of null-forming / interference suppression for LEO/NTN scenarios.",
    links: [{ label: "Code", href: "https://github.com/Shizhen-Jia/NTN-Anti-Jamming" }],
    tags: ["LEO Satellites", "Anti-Jamming", "Non-Terrestrial Networks", "NTN", "Game Theory"],
    media: [],
  },
  {
    slug: "ota-phase-measurements-calibration",
    name: "OTA phase measurements and array calibration",
    desc: "From link-level methods to system-level evaluation with realistic geometry and overhead modeling.",
    links: [],
    tags: ["Phase Measurement", "Multipath", "FR3 Multi-band"],
    media: [],
  },
];
---

<BaseLayout title="Projects | Shizhen Jia" active="projects">
  <style>
    .projects-page {
      display: grid;
      gap: 18px;
    }

    .hero {
      position: relative;
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 18px;
      background:
        radial-gradient(90% 140% at 100% 0%, rgba(126, 216, 197, 0.18), transparent 58%),
        linear-gradient(140deg, rgba(138, 180, 248, 0.09), rgba(255, 255, 255, 0.02) 58%),
        rgba(255, 255, 255, 0.02);
      box-shadow: inset 0 1px rgba(255, 255, 255, 0.08), 0 14px 34px rgba(0, 0, 0, 0.24);
    }

    .hero::after {
      content: "";
      position: absolute;
      width: 180px;
      height: 180px;
      top: -65px;
      right: -55px;
      border-radius: 999px;
      pointer-events: none;
      background: radial-gradient(circle, rgba(138, 180, 248, 0.25), rgba(138, 180, 248, 0) 72%);
    }

    .eyebrow {
      margin: 0 0 6px;
      font-size: 12px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #9fc8ff;
      font-weight: 700;
    }

    .hero h1 {
      margin: 0;
      font-size: 42px;
      letter-spacing: -0.5px;
      font-family: "Palatino Linotype", Palatino, "Book Antiqua", Georgia, serif;
      color: #f5f7ff;
    }

    .hero p {
      margin: 10px 0 0;
      max-width: 760px;
      color: var(--muted);
      line-height: 1.65;
    }

    .hero-chips {
      margin-top: 14px;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .hero-chip {
      display: inline-flex;
      align-items: center;
      padding: 7px 11px;
      border-radius: 999px;
      border: 1px solid rgba(126, 216, 197, 0.25);
      background: rgba(126, 216, 197, 0.08);
      color: #b7e1dc;
      font-size: 12px;
      font-weight: 650;
      letter-spacing: 0.01em;
    }

    .project-list {
      display: grid;
      gap: 16px;
    }

    .project-card {
      position: relative;
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 18px;
      background:
        radial-gradient(100% 170% at 100% 0%, rgba(45, 128, 201, 0.15), transparent 56%),
        rgba(255, 255, 255, 0.02);
      box-shadow: inset 0 1px rgba(255, 255, 255, 0.08), 0 10px 30px rgba(0, 0, 0, 0.2);
      transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
    }

    .project-card::before {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      border-radius: inherit;
      background: linear-gradient(
        116deg,
        rgba(255, 255, 255, 0) 18%,
        rgba(255, 255, 255, 0.12) 50%,
        rgba(255, 255, 255, 0) 82%
      );
      opacity: 0;
      transform: translateX(-65%);
      transition: transform 640ms ease, opacity 300ms ease;
    }

    .project-card:hover {
      transform: translateY(-2px);
      border-color: rgba(126, 216, 197, 0.32);
      box-shadow: inset 0 1px rgba(255, 255, 255, 0.1), 0 16px 34px rgba(0, 0, 0, 0.3);
    }

    .project-card:hover::before {
      opacity: 1;
      transform: translateX(68%);
    }

    .project-index {
      display: inline-flex;
      align-items: center;
      padding: 5px 10px;
      border-radius: 999px;
      border: 1px solid rgba(138, 180, 248, 0.35);
      background: rgba(138, 180, 248, 0.12);
      color: #c9dcff;
      font-size: 12px;
      font-weight: 650;
      margin-bottom: 10px;
    }

    .project-name {
      margin: 0;
      font-size: 27px;
      line-height: 1.24;
      color: #f4f6ff;
      letter-spacing: -0.2px;
      font-family: "Palatino Linotype", Palatino, "Book Antiqua", Georgia, serif;
    }

    .project-desc {
      margin: 10px 0 0;
      color: var(--muted);
      line-height: 1.64;
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 12px;
    }

    .tag {
      display: inline-flex;
      align-items: center;
      padding: 7px 11px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.16);
      background: rgba(255, 255, 255, 0.03);
      color: #ccdae9;
      font-size: 12px;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    }

    .media-grid {
      margin-top: 14px;
      display: grid;
      gap: 10px;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .media-frame {
      margin: 0;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--border);
      background: rgba(255, 255, 255, 0.02);
    }

    .media-frame img,
    .media-frame video {
      width: 100%;
      display: block;
    }

    .actions {
      margin-top: 14px;
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
    }

    .icon-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: rgba(255, 255, 255, 0.03);
      color: var(--link);
      text-decoration: none;
      transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
    }

    .icon-btn:hover {
      transform: translateY(-2px);
      border-color: rgba(138, 180, 248, 0.42);
      background: rgba(138, 180, 248, 0.12);
      text-decoration: none;
    }

    .text-btn {
      display: inline-flex;
      align-items: center;
      padding: 8px 12px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: rgba(255, 255, 255, 0.03);
      color: var(--text);
      text-decoration: none;
      font-size: 13px;
      font-weight: 600;
    }

    .text-btn:hover {
      text-decoration: none;
      border-color: rgba(126, 216, 197, 0.36);
      background: rgba(126, 216, 197, 0.1);
    }

    @media (max-width: 900px) {
      .hero h1 {
        font-size: 36px;
      }

      .project-name {
        font-size: 24px;
      }

      .media-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <div class="projects-page">
    <section class="hero">
      <p class="eyebrow">Research Projects</p>
      <h1>Projects</h1>
      <p>
        Selected work on NTN and LEO systems, with emphasis on interference suppression, anti-jamming,
        channel estimation, and system-level evaluation.
      </p>
      <div class="hero-chips">
        <span class="hero-chip">NTN / LEO</span>
        <span class="hero-chip">Signal Processing + Systems</span>
      </div>
    </section>

    <div class="project-list">
      {projects.map((p, idx) => (
        <article class="project-card">
          <span class="project-index">Project {idx + 1}</span>
          <h2 class="project-name">{p.name}</h2>
          <p class="project-desc">{p.desc}</p>

          <div class="tags">
            {p.tags.map((t) => (
              <span class="tag">{t}</span>
            ))}
          </div>

          {p.media?.length > 0 && (
            <div class="media-grid">
              {p.media.map((m) => (
                <figure class="media-frame">
                  {(m.type === "image" || m.type === "gif") && (
                    <img
                      src={m.src}
                      alt={m.alt ?? `${p.name} media`}
                      loading="lazy"
                    />
                  )}
                  {m.type === "video" && (
                    <video
                      src={m.src}
                      controls
                      preload="metadata"
                      poster={m.poster}
                    />
                  )}
                </figure>
              ))}
            </div>
          )}

          {p.links?.length > 0 && (
            <div class="actions">
              {p.links.map((l) => (
                l.label.toLowerCase() === "code" ? (
                  <a
                    class="icon-btn"
                    href={l.href}
                    target="_blank"
                    rel="noopener"
                    aria-label="GitHub code repository"
                    title="GitHub code repository"
                  >
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" style="fill:currentColor;">
                      <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.1c-3.34.73-4.04-1.61-4.04-1.61a3.17 3.17 0 0 0-1.34-1.74c-1.1-.74.08-.73.08-.73a2.5 2.5 0 0 1 1.82 1.23 2.53 2.53 0 0 0 3.45.98 2.54 2.54 0 0 1 .75-1.6c-2.67-.31-5.47-1.34-5.47-5.95a4.66 4.66 0 0 1 1.24-3.23 4.33 4.33 0 0 1 .12-3.18s1.01-.32 3.3 1.24a11.38 11.38 0 0 1 6.01 0c2.29-1.56 3.3-1.24 3.3-1.24.44 1.02.48 2.17.12 3.18a4.66 4.66 0 0 1 1.24 3.23c0 4.62-2.8 5.63-5.48 5.94a2.84 2.84 0 0 1 .81 2.2v3.27c0 .32.22.69.83.58A12 12 0 0 0 12 .5Z"/>
                    </svg>
                  </a>
                ) : (
                  <a
                    class="text-btn"
                    href={l.href}
                    target="_blank"
                    rel="noopener"
                  >
                    {l.label} ->
                  </a>
                )
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
