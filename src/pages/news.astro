---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="News | Shizhen Jia"
  description="News and updates from Shizhen Jia."
  active="news"
>
  <style>
    .news {
      min-height: 200px;
    }

    h1 {
      margin: 0;
      font-family: "Palatino Linotype", Palatino, "Book Antiqua", Georgia, serif;
      font-size: 42px;
      letter-spacing: -0.5px;
      color: #f5f7ff;
    }

    @media (max-width: 640px) {
      h1 {
        font-size: 34px;
      }
    }
  </style>

  <section class="news" aria-labelledby="news-title">
    <h1 id="news-title">News</h1>
  </section>
</BaseLayout>
